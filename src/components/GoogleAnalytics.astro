---
/**
 * GA4, loads 3s after full page load (LCP-first).
 *
 * The measurement ID comes from PUBLIC_GA_MEASUREMENT_ID when it is set, and falls back to
 * site.config.json otherwise. The fallback exists because the env-only version failed silently:
 * a deploy without the variable rendered no script at all and analytics vanished from every page
 * with nothing in the build output to say so. A GA4 measurement ID is public by design, it is
 * visible in the page source of any site that uses it, so keeping it in the repo is not a leak.
 */
import siteConfig from '../../site.config.json';

const fromEnv = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const fromConfig = (siteConfig as { analytics?: { ga4MeasurementId?: string } }).analytics
  ?.ga4MeasurementId;
const measurementId = fromEnv || fromConfig;

if (!measurementId) {
  console.warn('[analytics] GA4 measurement id missing: no PUBLIC_GA_MEASUREMENT_ID and no analytics.ga4MeasurementId in site.config.json');
}
---
{measurementId && (
  <script define:vars={{ measurementId }}>
    function scheduleAfterFullLoad(callback, delayMs) {
      const ms = delayMs ?? 3000;
      const run = () => setTimeout(callback, ms);
      if (document.readyState === 'complete') run();
      else window.addEventListener('load', run, { once: true });
    }

    function bootGoogleAnalytics() {
      const loader = document.createElement('script');
      loader.async = true;
      loader.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
      document.head.appendChild(loader);

      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', measurementId, {
        send_page_view: true,
        anonymize_ip: true,
      });

      window.operStackTrack = function operStackTrack(eventName, params = {}) {
        const payload = {
          page_location: window.location.href,
          page_path: window.location.pathname,
          transport_type: 'beacon',
          ...params,
        };
        if (typeof window.gtag === 'function') {
          window.gtag('event', eventName, payload);
        }
      };
      window.moreTrack = window.operStackTrack;

      // Всё, что произошло до загрузки GA, отправляем сейчас. Иначе заявка,
      // отправленная в первые секунды, теряется молча: вызывающий код проверяет
      // typeof window.operStackTrack === 'function' и тихо ничего не делает.
      const queued = window.operStackQueue || [];
      window.operStackQueue = [];
      queued.forEach(([eventName, params]) => window.operStackTrack(eventName, params));
    }

    /* Заглушка на время до загрузки GA: складывает события в очередь.
       Заменяется настоящей функцией в bootGoogleAnalytics. */
    window.operStackQueue = window.operStackQueue || [];
    window.operStackTrack = function queueTrack(eventName, params = {}) {
      window.operStackQueue.push([eventName, params]);
    };
    window.moreTrack = window.operStackTrack;

    scheduleAfterFullLoad(bootGoogleAnalytics, 3000);
  </script>
)}
