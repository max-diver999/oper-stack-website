---
import Favicon from './Favicon.astro';
import GoogleAnalytics from './GoogleAnalytics.astro';
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';
import { lastmodFor } from '../lib/page-lastmod';

interface Props {
  title: string;
  description: string;
  canonical: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Social card, absolute or site-relative. Defaults to the brand card. */
  ogImage?: string;
  /** Set on articles: emits og:type article and the published and modified times. */
  article?: { published: string; modified: string };
  /** Страницы с чужим адресом в запросе: результат проверки не место в индексе. */
  noindex?: boolean;
}

const { title, description, canonical, jsonLd = [], ogImage = '/og/og-default.png', article, noindex = false } = Astro.props;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE.url}${ogImage}`;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  email: SITE.email,
  founder: {
    '@type': 'Person',
    name: 'Maksim Shchegolev',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.address.locality,
    addressCountry: SITE.address.country,
  },
  sameAs: [...SITE.sameAs, `https://t.me/${SITE.telegram}`],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: SITE.email,
    url: `${SITE.url}/contact/`,
    availableLanguage: ['English', 'Russian'],
  },
};

// Every page type carries a modification date, not only the articles. Articles use
// their own frontmatter date; the rest use the committed git-derived map.
const modified = article?.modified ?? lastmodFor(canonical);
const webPageSchema = modified
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE.url}/#website` },
      publisher: { '@id': `${SITE.url}/#organization` },
      dateModified: modified,
      ...(article?.published ? { datePublished: article.published } : {}),
    }
  : null;

const extra = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const schemas = [organizationSchema, ...(webPageSchema ? [webPageSchema] : []), ...extra];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex
    ? <meta name="robots" content="noindex,follow" />
    : <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  {article && <meta property="article:published_time" content={article.published} />}
  {article && <meta property="article:modified_time" content={article.modified} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <Favicon />
  <link rel="preload" href="/fonts/dm-sans-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <JsonLd data={schemas} />
  <GoogleAnalytics />
  <style is:global>
    :root {
      --ink: #0B1017;
      --paper: #F5F2EC;
      --teal: #1A8A7D;
      --teal-soft: #3DB8A9;
      --amber-soft: #E8B84A;
      --muted: #8B939E;
      --fd: 'Fraunces', Georgia, serif;
      --fb: 'DM Sans', system-ui, sans-serif;
      --fm: 'JetBrains Mono', ui-monospace, monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: var(--fb);
      background: var(--ink);
      color: var(--paper);
      line-height: 1.55;
      min-height: 100vh;
    }
    a { color: var(--teal-soft); }
    a:hover { text-decoration: none; }
    .site-nav {
      display: flex;
      flex-wrap: wrap;
      gap: 10px 20px;
      padding: 20px 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      font-family: var(--fm);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }
    .site-nav a {
      text-decoration: none;
      color: var(--muted);
    }
    .site-nav a:hover,
    .site-nav a.active {
      color: var(--teal-soft);
    }
    .wrap {
      max-width: 820px;
      margin: 0 auto;
      padding: 40px 24px 80px;
    }
    .wrap.wide { max-width: 960px; }
    h1 {
      font-family: var(--fd);
      font-size: clamp(28px, 5vw, 42px);
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin-bottom: 12px;
    }
    .lede {
      color: rgba(245, 242, 236, 0.82);
      font-size: 17px;
      margin-bottom: 28px;
      max-width: 62ch;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 13px 20px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--teal), #156b62);
      color: #fff;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
      border: none;
      cursor: pointer;
    }
    .btn:hover { filter: brightness(1.06); }
    .btn-ghost {
      background: transparent;
      border: 1px solid rgba(61, 184, 169, 0.35);
      color: var(--teal-soft);
    }
    .site-foot {
      max-width: 820px;
      margin: 0 auto;
      padding: 0 24px 48px;
      font-size: 13px;
      color: var(--muted);
    }
    .site-foot .foot-links { margin-top: 8px; }
    .site-foot .foot-links a { color: var(--muted); }
    .site-foot .foot-links a:hover { color: var(--teal-soft); }
    .prose h2 {
      font-family: var(--fd);
      font-size: 24px;
      margin: 36px 0 12px;
      letter-spacing: -0.02em;
    }
    .prose h3 {
      font-size: 18px;
      margin: 24px 0 8px;
    }
    .prose p {
      margin-bottom: 16px;
      color: rgba(245, 242, 236, 0.88);
    }
    .prose ul, .prose ol {
      margin: 0 0 20px 22px;
      color: rgba(245, 242, 236, 0.85);
    }
    .prose li { margin-bottom: 8px; }
    .prose a { color: var(--teal-soft); }
    .prose table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0 28px;
      font-size: 14px;
    }
    .prose th, .prose td {
      border: 1px solid rgba(255, 255, 255, 0.1);
      padding: 10px 12px;
      text-align: left;
    }
    .prose th {
      background: rgba(61, 184, 169, 0.12);
      color: var(--teal-soft);
      font-family: var(--fm);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* Телефон. Мобильных стилей у сайта не было вовсе: ссылки в шапке были высотой в шестнадцать
       пикселей, а таблица из четырёх колонок сжималась до одного слова в строке. */
    @media (max-width: 680px) {
      .site-nav {
        gap: 2px 18px;
        padding: 6px 16px;
        font-size: 11px;
      }
      /* Отступы поднимают область нажатия до сорока, а выглядит ссылка ровно как выглядела. */
      .site-nav a {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
      }

      .wrap,
      .site-foot { padding-left: 18px; padding-right: 18px; }
      .wrap { padding-top: 28px; padding-bottom: 56px; }

      .lede { font-size: 16px; }

      /* Кнопку на телефоне ищут большим пальцем, а не глазами. */
      .btn {
        display: flex;
        justify-content: center;
        text-align: center;
        width: 100%;
        padding: 15px 18px;
      }
      .btn + .btn,
      .btn-ghost { margin-top: 10px; margin-left: 0 !important; }

      /* Строка таблицы становится карточкой, а каждая ячейка получает подпись своей колонки.
         Подписи проставляет сборка. */
      .prose table,
      .prose tbody,
      .prose tr,
      .prose td { display: block; width: 100%; }
      .prose thead { display: none; }
      .prose table { border: 0; margin: 18px 0 26px; }
      .prose tr {
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        margin-bottom: 12px;
        padding: 4px 0;
        background: rgba(255, 255, 255, 0.02);
      }
      .prose td {
        border: 0;
        padding: 9px 14px;
        font-size: 15px;
        line-height: 1.5;
      }
      .prose td[data-label]::before {
        content: attr(data-label);
        display: block;
        font-family: var(--fm);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--teal-soft);
        margin-bottom: 3px;
      }
      .prose td:empty { display: none; }
    }
  </style>
</head>
<body>
  <nav class="site-nav" aria-label="Site">
    <a href="/">Map</a>
    <a href="/services/" class:list={{ active: Astro.url.pathname.startsWith('/services') }}>Services</a>
    <a href="/products/" class:list={{ active: Astro.url.pathname.startsWith('/products') }}>Products</a>
    <a href="/pricing/" class:list={{ active: Astro.url.pathname.startsWith('/pricing') }}>Pricing</a>
    <a href="/cases/" class:list={{ active: Astro.url.pathname.startsWith('/cases') }}>Cases</a>
    <a href="/guides/" class:list={{ active: Astro.url.pathname.startsWith('/guides') }}>Guides</a>
    <a href="/about/" class:list={{ active: Astro.url.pathname.startsWith('/about') }}>About</a>
    <a href="/audit/">Audit</a>
  </nav>
  <slot />
  <footer class="site-foot">
    <p>{SITE.name} · {SITE.tagline}</p>
    <p style="margin-top:8px"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    <p class="foot-links"><a href="/about/">About</a> · <a href="/contact/">Contact</a> · <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/refunds/">Refunds</a></p>
  </footer>
</body>
</html>
