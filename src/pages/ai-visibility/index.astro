---
import CommercialLayout from '../../components/CommercialLayout.astro';
import CitabilityBlock from '../../components/CitabilityBlock.astro';
import ownScore from '../../data/own-score.json';
import FaqSection from '../../components/FaqSection.astro';
import { SITE } from '../../data/site';

const canonical = `${SITE.url}/ai-visibility/`;
const FAQ = [
  { question: 'What does the check look at?', answer: 'Five things an answer engine needs before it can cite a site: whether its crawlers are allowed in robots.txt, whether there is an llms.txt map, whether schema names the entity, whether the sampled pages open with a quotable answer and carry tables, and whether pages expose dates and name sources. It reads the homepage, robots.txt, llms.txt, the sitemap and up to three pages.' },
  { question: 'Does it measure traffic from ChatGPT or Perplexity?', answer: 'No. Traffic lives in your analytics. This check measures whether the site is readable and quotable in the first place, which is the part you control. The OperStack plugin for Claude Code has an ai-visibility command that reads the GA4 side.' },
  { question: 'Is anything stored?', answer: 'We keep a line for each check: the address checked, the score, and which link brought you here. We do not keep your IP address, and we do not sell or share any of it. Your email is kept only if you leave it to get the fix, and every email we send has one-click unsubscribe.' },
  { question: 'Why did my site score low on content when the pages are long?', answer: 'Length is not the signal. The check looks for an answer-first paragraph of 20 to 90 words with a figure right after the H1, at least three H2 sections and a table. Long pages that bury the answer score low because engines quote the opening, not the middle.' },
  { question: 'What is the difference between this and the audit?', answer: 'This is the free, automatic, ten-second version of the first two pages of the audit. The audit adds an analyst, Search Console data, competitor pages, and a ten-page report with a price on every fix.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.question, acceptedAnswer: { '@type': 'Answer', text: f.answer } })) };
const appSchema = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'OperStack AI Visibility Check', url: canonical, applicationCategory: 'SEO tool', operatingSystem: 'Web', offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' }, provider: { '@type': 'Organization', name: SITE.name, url: SITE.url } };
---
<CommercialLayout title="AI Visibility Check: Can AI Assistants Cite Your Site? · OperStack" description="Free ten-second check of whether ChatGPT, Perplexity, Copilot, Claude and Gemini can read, understand and cite your site: crawler access, llms.txt, schema, quotable content, dates." canonical={canonical} ogImage="/og/og-ai-visibility.png" jsonLd={[appSchema, faqSchema]}>
  <div class="wrap">
    <p class="label">Free tool</p>
    <h1>Can AI assistants read and cite your site?</h1>
    <p class="lede">Enter a site. In about ten seconds you get a score out of 100 across the five things an answer engine needs before it quotes a page, and the three fixes that move it most.</p>
    <p class="coverage">Other tools check one page. We check ten.</p>
    <CitabilityBlock text="The OperStack AI visibility check reads a site's robots.txt, llms.txt, sitemap, schema and a sample of pages, and scores whether ChatGPT, Perplexity, Copilot, Claude and Gemini can read, understand and cite it. It is free and uses public signals only." />

    <form id="vis-form" class="vis-form" novalidate>
      <label for="vis-url" class="sr">Site address</label>
      <input id="vis-url" name="url" type="text" inputmode="url" placeholder="example.com" autocomplete="url" required />
      <button type="submit" class="btn" id="vis-btn">Check the site →</button>
    </form>
    <p class="note" id="vis-note">Public signals only. We log the address checked and the score, never your IP.</p>

    {ownScore?.score != null && (
      <p class="ownscore">
        <b>Our own site scores {ownScore.score} of 100</b> on this same check, measured {ownScore.measured} across
        {' '}{ownScore.pagesRead} pages. Put <code>{ownScore.host}</code> in the box above and see for yourself: a tool
        that grades your site should be willing to say what it gives its maker. The number is measured on every build,
        never typed, so it drops the day we let something slip.
      </p>
    )}

    <section id="vis-result" class="result" hidden aria-live="polite"></section>

    <section id="vis-capture" class="capture" hidden>
      <h2 id="capture-head">Get the first fix as a letter</h2>
      <p id="capture-sub">The fix that moves your score most, written out in full: what your site does now, what to change, and how to check it worked. One letter, so you can hand it to whoever runs the site. It arrives in a few minutes.</p>
      <form id="pdf-form" novalidate>
        <input type="hidden" name="source" id="pdf-source" value="ai-visibility" />
        <div><label for="pdf-email">Email</label><input id="pdf-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" /></div>
        <div class="consent"><input type="checkbox" id="pdf-consent" name="consent" required /><label for="pdf-consent">I agree to receive this letter by email and, at most once a month, a note when a check changes. One click unsubscribes.</label></div>
        <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
        <button type="submit" class="btn" id="pdf-btn">Email me the fix →</button>
        <p class="msg" id="pdf-msg" hidden></p>
      </form>
    </section>

    <!--
      Everything below the exchange. Split on purpose: the form has to sit right after the blurred
      list, while the person has just seen what was withheld. On 16.09.2026 it sat 2817px down the
      page, three screens below the score, and almost nobody reached it.
    -->
    <section id="vis-more" class="result" hidden></section>

    <!-- Врезка стоит сразу под результатом: человек только что увидел свой балл, и это
         самый естественный момент сказать, что то же самое работает у него в рабочем окне.
         Блок статический, не прячется: до проверки он читается как возможность, после
         проверки как следующий шаг. -->
    <section class="mcp">
      <h2>Prefer to do this inside Claude or ChatGPT?</h2>
      <p>If you already work with Claude, ChatGPT or Cursor, they can run this check for you, in the window you are already in. You write in plain words: <em>look at my site</em>, <em>compare me with these three</em>, <em>how many AI visits did I get this month</em>.</p>
      <p class="addr"><code id="mcp-url">https://oper-stack.com/api/mcp/</code><button type="button" id="mcp-copy" class="copy">Copy</button></p>
      <p class="note">Paste it into your program's settings once. Nothing to install, no account, no payment. The slash at the end matters: without it some programs do not follow the redirect.</p>
      <p class="note"><a href="/mcp/">Step-by-step setup for each program →</a></p>
    </section>

    <h2>What the check measures</h2>
    <ol class="areas-list">
      <li><strong>Access, 25 points.</strong> robots.txt read per user agent for fourteen AI crawlers and fetchers. A blocked search fetcher costs more than a blocked training crawler, because the fetchers are the bots that cite pages live.</li>
      <li><strong>Agent map, 15 points.</strong> llms.txt exists, is text, and links to the site's own pages rather than a template demo.</li>
      <li><strong>Entity, 20 points.</strong> Organization or business schema, FAQPage, a page-level type (Article, Service, Product, Course and the like), a canonical tag and Open Graph on the homepage.</li>
      <li><strong>Quotable content, 25 points.</strong> On up to three sampled pages: at least 300 words, an answer-first paragraph with a figure right after the H1, three or more H2 sections, a table.</li>
      <li><strong>Dates and sources, 15 points.</strong> Publication dates in meta or schema, source phrases in the text, a sitemap with lastmod.</li>
    </ol>

    <h2>What it does not measure</h2>
    <ul class="areas-list">
      <li>Traffic or citations already happening. This check asks whether a machine <em>can</em> read and quote you, not whether anybody arrived. To count the visits assistants already send you, <a href="/visits/">put the free counter on your own site</a>.</li>
      <li>Rankings, backlinks or keyword demand.</li>
      <li>Pages that need a login, or sites that block the checker itself.</li>
    </ul>

    <section class="cta-box">
      <h2>Run the full gates on your own corpus</h2>
      <p>The check reads a sample. The sixteen gates read every page in your repository, in one command, for free.</p>
      <p style="margin-top:14px"><code class="cmd">npx @operstack/gates</code> · <a href="/products/gates/">What the gates check</a></p>
    </section>

    <FaqSection items={FAQ} />
  </div>

  <script>
    const form = document.getElementById('vis-form') as HTMLFormElement;
    const input = document.getElementById('vis-url') as HTMLInputElement;
    const btn = document.getElementById('vis-btn') as HTMLButtonElement;
    const note = document.getElementById('vis-note') as HTMLElement;
    /** Host of the last run: the confirmation names it. */
    let lastHost = '';
    const out = document.getElementById('vis-result') as HTMLElement;
    const capture = document.getElementById('vis-capture') as HTMLElement;
    const pdfForm = document.getElementById('pdf-form') as HTMLFormElement;
    const pdfSource = document.getElementById('pdf-source') as HTMLInputElement;
    const pdfMsg = document.getElementById('pdf-msg') as HTMLElement;
    const pdfBtn = document.getElementById('pdf-btn') as HTMLButtonElement;
    const loadedAt = Date.now();
    let last: any = null;

    // Человек приходит по ссылке с меткой площадки, но проверку может запустить через
    // несколько кликов. Запоминаем метку на время визита, иначе в таблице у всех будет
    // "прямой заход" и мы не узнаем, какая соцсеть на самом деле приводит людей.
    function origin(): { from: string; campaign: string } {
      const KEY = 'os-origin';
      try {
        const q = new URLSearchParams(location.search);
        const from = q.get('utm_source') || q.get('ref') || '';
        const campaign = q.get('utm_campaign') || '';
        if (from) { const v = { from, campaign }; sessionStorage.setItem(KEY, JSON.stringify(v)); return v; }
        const saved = sessionStorage.getItem(KEY);
        if (saved) return JSON.parse(saved);
      } catch {
        // Приватное окно или запрет на хранилище: тогда источник определит сервер по Referer.
      }
      return { from: '', campaign: '' };
    }

    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
    const track = (name: string, params: Record<string, unknown>) => { const w = window as any; if (typeof w.operStackTrack === 'function') w.operStackTrack(name, params); };

    /**
     * The same check on the sites you lose answers to. One scale, so the comparison means
     * something, and every number on the row is measured rather than asserted.
     */
    function wireCompare(mine: any) {
      const box = out.querySelector('.compare') as HTMLElement;
      if (!box) return;
      const go = box.querySelector('.cmp-go') as HTMLButtonElement;
      const msg = box.querySelector('.cmp-msg') as HTMLElement;
      const table = box.querySelector('.cmp-out') as HTMLElement;

      go.addEventListener('click', async () => {
        const domains = [...box.querySelectorAll('.cmp-row input')]
          .map((i) => (i as HTMLInputElement).value.trim())
          .filter(Boolean)
          .slice(0, 3);
        if (!domains.length) { msg.hidden = false; msg.textContent = 'Put in at least one site.'; return; }
        go.disabled = true;
        msg.hidden = false;
        msg.textContent = 'Checking ' + domains.length + (domains.length === 1 ? ' site' : ' sites') + '. Ten seconds at most.';
        track('ai_visibility_compare', { count: domains.length });

        const results = await Promise.all(domains.map(async (d) => {
          try {
            const res = await fetch('/api/ai-visibility/', {
              method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ url: d }),
            });
            const j = await res.json();
            return res.ok && j.ok !== false ? j : { host: d, failed: true };
          } catch { return { host: d, failed: true }; }
        }));

        const all = [mine, ...results.filter((x: any) => !x.failed)];
        const failed = results.filter((x: any) => x.failed).map((x: any) => x.host);
        if (all.length < 2) {
          msg.textContent = 'None of those answered. They may block automated readers.';
          go.disabled = false;
          return;
        }

        const labels = mine.areas.map((a: any) => a.label);
        const head = '<tr><th>Site</th><th class="n">Score</th>' + labels.map((l: string) => `<th class="n">${esc(l)}</th>`).join('') + '</tr>';
        const rows = all.map((r: any, i: number) => {
          const cells = r.areas.map((a: any, k: number) => {
            // Неизмеренную область нельзя сравнивать: null в сравнении ведёт себя как ноль,
            // и сайт, у которого robots.txt не прочитался, выглядел бы хуже, чем он есть.
            const mineScore = mine.areas[k] ? mine.areas[k].score : null;
            const better = i > 0 && a.score != null && mineScore != null && a.score > mineScore;
            return `<td class="n${better ? ' beat' : ''}">${a.score == null ? 'not measured' : `${a.score}/${a.max}`}</td>`;
          }).join('');
          const beatsMe = i > 0 && r.score > mine.score;
          return `<tr${i === 0 ? ' class="me"' : ''}><td>${esc(r.host)}${i === 0 ? ' <span class="you">you</span>' : ''}</td><td class="n${beatsMe ? ' beat' : ''}">${r.score}</td>${cells}</tr>`;
        }).join('');

        const ahead = all.slice(1).filter((r: any) => r.score > mine.score).length;
        const verdict = ahead === 0
          ? 'You score higher than every site you listed.'
          : ahead + (ahead === 1 ? ' of them scores' : ' of them score') + ' higher than you. The amber numbers are where.';

        table.innerHTML = `<p class="cmp-verdict">${verdict}</p><div class="cmp-wrap"><table>${head}${rows}</table></div>` +
          (failed.length ? `<p class="note">No answer from: ${failed.map(esc).join(', ')}. Sites that block automated readers cannot be scored from outside.</p>` : '');
        table.hidden = false;
        msg.hidden = true;
        go.disabled = false;
      });
    }

    function render(r: any) {
      const ring = 2 * Math.PI * 54;
      // Балл, области и всё, что пройдено, видно сразу: это и есть приманка, цифра про его сайт.
      // Из проблем показываем первые три, остальные считаем и отдаём за почту. Иначе человеку
      // незачем её оставлять, а без почты вся дальнейшая воронка не существует.
      // Пройденные проверки показываем целиком: хорошая новость про свой сайт не товар.
      // Проблемы сюда не приходят вовсе, обработчик их не отдаёт: одна показана целиком
      // правкой выше, остальные лежат в r.rest заголовками по четыре слова.
      const rest: Array<{ area: string; level: string; teaser: string }> = Array.isArray(r.rest) ? r.rest : [];
      const hidden = rest.length;
      const areas = r.areas.map((a: any) => {
        const shown = (a.findings || [])
          .filter((f: any) => f.level === 'pass')
          .map((f: any) => `<li class="f-pass"><span class="chip">OK</span>${esc(f.text)}</li>`);
        const n = Number(a.problems) || 0;
        const tail = n ? `<li class="f-more">${n} ${n === 1 ? 'finding' : 'findings'} in the list below</li>` : '';
        return `
        <div class="area">
          <div class="area-head"><span>${esc(a.label)}</span><strong>${a.score == null ? 'not measured' : `${a.score}/${a.max}`}</strong></div>
          ${a.score == null ? '' : `<div class="bar"><i style="width:${Math.round((a.score / a.max) * 100)}%"></i></div>`}
          <ul>${shown.join('')}${tail}</ul>
        </div>`;
      }).join('');
      /**
       * Остальные находки этого же прогона. Число здесь ровно столько, сколько их нашлось,
       * а заголовки настоящие: они приходят с сервера обрезанными до четырёх слов, поэтому
       * размытие показывает форму списка и не прячет то, что уже уехало в браузер.
       * Находок кроме первой нет, значит блока нет: ноль правок это хорошая новость,
       * и сказать её надо словами, а не строкой «ещё 0».
       */
      const locked = hidden
        ? `<div class="rest">
            <h3>${hidden} more ${hidden === 1 ? 'fix' : 'fixes'} on ${esc(r.host)}</h3>
            <ul class="rest-list">${rest.map((x) => `<li class="r-${esc(x.level)}"><span class="chip">${x.level === 'warn' ? 'Partial' : 'Problem'}</span><span class="r-area">${esc(x.area)}:</span> <span class="smudge">${esc(x.teaser)}</span></li>`).join('')}</ul>
            <p class="note">These are the findings of this very run on ${esc(r.host)}, and the count is exactly how many there are. What to change and how to check it belongs to the fix list.</p>
            <a class="btn" href="/products/site-report/">Every fix for your site, as a list you can hand over</a>
          </div>`
        : r.fixes.length
          ? `<p class="clean">Nothing else was found: apart from the fix above, there is nothing to repair on ${esc(r.host)}.</p>`
          : `<p class="clean">The check found nothing to fix on ${esc(r.host)}. That is the whole result, and it is a good one.</p>`;
      /*
       * Первая правка тремя частями: что сейчас, что сделать, как проверить. Текст приходит
       * готовым из обработчика, который берёт его из пакета, поэтому на экране, в письме и в
       * файле задач за 9 стоят одни и те же слова. Пакет не знает этой находки, значит трёх
       * частей нет: показываем находку как есть, а развёрнутую правку человек получит письмом.
       */
      const fp = r.firstFix;
      const fixes = !r.fixes.length ? '' : fp
        ? `<div class="fixes"><h3>The fix that moves the score most</h3>
            <p class="fix-area">${esc(fp.area)}</p>
            <dl class="fix-parts">
              <dt>${esc(fp.labels.now)}</dt><dd>${esc(fp.now)}</dd>
              <dt>${esc(fp.labels.task)}</dt><dd>${esc(fp.task)}</dd>
              <dt>${esc(fp.labels.verify)}</dt><dd>${esc(fp.verify)}</dd>
            </dl>
            <p class="note">Copy all three lines and hand them over as they are: without "now" and "how to check" whoever does the work cannot tell where to start or when it is done.</p>
          </div>`
        : `<div class="fixes"><h3>The fix that moves the score most</h3><p class="fix-one"><strong>${esc(r.fixes[0].area)}.</strong> ${esc(r.fixes[0].text)}</p><p class="note">Leave an email below and this fix arrives written out in full: what is there now, what to change, how to check it worked.</p></div>`;
      const pages = r.sample.length ? `<details class="more"><summary>Pages sampled (${r.sample.length})</summary><table><tr><th>Page</th><th>Words</th><th>Answer first</th><th>Dated</th><th>Schema</th></tr>${r.sample.map((p: any) => `<tr><td><a href="${esc(p.url)}" rel="nofollow noopener" target="_blank">${esc(new URL(p.url).pathname)}</a></td><td>${p.words}</td><td>${p.answerFirst ? 'yes' : 'no'}</td><td>${p.dated ? 'yes' : 'no'}</td><td>${esc(p.schema.join(', ') || 'none')}</td></tr>`).join('')}</table></details>` : '';
      const crawlers = `<details class="more"><summary>Crawlers checked (${r.crawlers.length})</summary><table><tr><th>Crawler</th><th>Kind</th><th>robots.txt</th></tr>${r.crawlers.map((c: any) => `<tr><td>${esc(c.label)}</td><td>${c.kind === 'search' ? 'search and citation' : 'training'}</td><td class="${c.verdict === 'blocked' ? 'bad' : 'ok'}">${c.verdict}</td></tr>`).join('')}</table></details>`;
      /*
       * Ссылка на сохранённый результат и значок. До 17.09.2026 результат жил только во вкладке:
       * его нельзя было переслать разработчику, открыть через неделю и нечем было похвастаться у
       * себя на сайте. Ссылка появляется, только если результат действительно сохранился: на
       * площадке без базы блок просто не рисуется, вместо того чтобы обещать несуществующий адрес.
       */
      const keep = r.permalink
        ? `<div class="keep">
             <h3>Keep this result</h3>
             <p><a href="${esc(r.permalink)}">${esc(location.origin + r.permalink)}</a> holds this run: send it to whoever runs the site, or open it in a week and compare.</p>
             <p class="keep-badge"><img src="${esc(r.badge)}" alt="AI visibility score" width="180" height="28" loading="lazy" /></p>
             <p class="note">Put the badge on your own site from that page. It updates itself: check again and it shows the new number, with nothing to change on your page.</p>
           </div>`
        : '';
      out.innerHTML = `
        <div class="score-row">
          <svg viewBox="0 0 120 120" class="ring" aria-label="Score ${r.score} of 100"><circle cx="60" cy="60" r="54" class="ring-bg"/><circle cx="60" cy="60" r="54" class="ring-fg g-${r.grade}" stroke-dasharray="${ring}" stroke-dashoffset="${ring * (1 - r.score / 100)}"/><text x="60" y="56" text-anchor="middle" class="ring-num">${r.score}</text><text x="60" y="76" text-anchor="middle" class="ring-sub">of 100</text></svg>
          <div>
            <p class="label">Grade ${esc(r.grade)} · ${esc(r.host)}</p>
            <h2 class="verdict">${r.score >= 80 ? 'AI systems can read and quote this site.' : r.score >= 65 ? 'Readable, with gaps that cost citations.' : r.score >= 45 ? 'Readable, but there is little to quote.' : 'Mostly invisible to answer engines.'}</h2>
            <p class="note">Checked ${new Date(r.checkedAt).toLocaleString('en-GB')} in ${(r.ms / 1000).toFixed(1)} s. Sitemap: ${r.sitemap.found ? `${r.sitemap.count} URLs${r.sitemap.lastmod ? ', dated' : ', no dates'}` : r.sitemap.unchecked ? 'did not answer in time, not checked' : 'not found'}.</p>
            <p class="note">${(() => { const n = r.sample.length; const of = r.sitemap.found && r.sitemap.count > n ? ` of the ${r.sitemap.count} listed in the sitemap` : ' of the site'; return `This is a first pass: ${n} page${n === 1 ? '' : 's'}${of} ${n === 1 ? 'was' : 'were'} read. The full report carries this same score, from the same code, and shows what it is made of. Running the check again can move it by a point or two: a check that answers in time on one run may not on the next, and this score never counts against a site what it could not read.`; })()}</p>
          </div>
        </div>
        ${fixes}
        ${locked}
        ${keep}`;
      const more = document.getElementById('vis-more') as HTMLElement;
      more.innerHTML = `
        <div class="areas">${areas}</div>
        ${pages}${crawlers}
        <div class="compare">
          <h3>How do you compare?</h3>
          <p class="note">Put in up to three sites you lose answers to. Same check, same scale, side by side.</p>
          <div class="cmp-row">
            <input type="text" inputmode="url" placeholder="competitor.com" aria-label="First competitor" />
            <input type="text" inputmode="url" placeholder="another.com" aria-label="Second competitor" />
            <input type="text" inputmode="url" placeholder="third.com" aria-label="Third competitor" />
            <button type="button" class="btn cmp-go">Compare</button>
          </div>
          <p class="cmp-msg note" hidden></p>
          <div class="cmp-out" hidden></div>
        </div>
        <p class="next">This check reads one page. The <a href="/products/site-report/">site fix list</a> reads up to twenty and turns every failure into a task written in plain words: what your site does now, what to change, how to check it worked. Hand a task to your developer or paste it into ChatGPT, Claude or Cursor. 9 USD, no code, nothing to install.</p>`;
      more.hidden = false;
      wireCompare(r);
      out.hidden = false;
      // Чинить нечего, значит и обменивать почту не на что. Предлагать «первую правку письмом»
      // сайту, у которого правок нет, значит обещать письмо, которого не будет.
      capture.hidden = !r.fixes.length;
      const head = document.getElementById('capture-head') as HTMLElement;
      const sub = document.getElementById('capture-sub') as HTMLElement;
      /*
       * The ask is made in the visitor's own numbers. "Get the first fix as a letter" meant nothing
       * to someone who had just read that first fix in full above. The letter now buys the second
       * fix and the names of the remaining findings; how to fix each of those stays in the paid
       * list, and that line does not move.
       */
      lastHost = r.host;
      const n = r.rest.length;
      head.innerHTML = n
        ? `You scored ${r.score} out of 100.<br>We did not show you ${n} more finding${n === 1 ? '' : 's'} on ${esc(r.host)}.`
        : `You scored ${r.score} out of 100.`;
      sub.textContent = n
        ? 'We will email you the second fix written out in full, like the one above, and the names of the rest, so you see the whole picture. Keep it, or hand it to whoever runs the site.'
        : `The fix above, written out in full for ${r.host}: what the site does now, what to change, how to check it worked.`;
      if (pdfBtn) pdfBtn.textContent = n ? 'Email me the full list →' : 'Email me the fix →';
      pdfSource.value = `ai-visibility:${r.host}:${r.score}`;
      out.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    const mcpCopy = document.getElementById('mcp-copy') as HTMLButtonElement | null;
    mcpCopy?.addEventListener('click', async () => {
      const url = document.getElementById('mcp-url')?.textContent?.trim() || '';
      try {
        await navigator.clipboard.writeText(url);
        mcpCopy.textContent = 'Copied';
      } catch {
        // Буфер обмена может быть закрыт настройками браузера. Тогда выделяем адрес,
        // чтобы человеку осталось нажать только «копировать» самому.
        const node = document.getElementById('mcp-url');
        if (node) { const r = document.createRange(); r.selectNodeContents(node); const sel = getSelection(); sel?.removeAllRanges(); sel?.addRange(r); }
        mcpCopy.textContent = 'Select and copy';
      }
      setTimeout(() => { mcpCopy.textContent = 'Copy'; }, 2500);
    });

    // The homepage form lands here with ?url=: fill the field and run at once, so the person
    // who typed the address on the homepage does not have to type it a second time.
    const preset = (new URLSearchParams(location.search).get('url') || '').trim();
    /*
     * requestSubmit появился в Safari только в версии 16, а на айфонах, которые больше не
     * обновляются, живут версии старше. Там вызов просто ничего не делает, и человек,
     * пришедший с главной, видит свой адрес в поле и пустой экран под ним. Поэтому запасной
     * путь: отправить форму событием, которое слушает тот же обработчик.
     */
    if (preset) {
      input.value = preset;
      setTimeout(() => {
        if (typeof form.requestSubmit === 'function') form.requestSubmit();
        else form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
      }, 0);
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const url = input.value.trim();
      if (!url) { input.focus(); return; }
      btn.disabled = true; btn.textContent = 'Checking…'; note.textContent = 'Reading robots.txt, llms.txt, the sitemap and a few pages. Ten seconds at most.';
      try {
        const o = origin();
        const tail = o.from ? `&from=${encodeURIComponent(o.from)}&campaign=${encodeURIComponent(o.campaign)}` : '';
        const res = await fetch(`/api/ai-visibility/?url=${encodeURIComponent(url)}${tail}`);
        // The server can answer with something that is not JSON (a host error page, a function
        // that is off). The person used to see a JSON parse error like "Unexpected token '<'".
        // Now they see a sentence that says what to do.
        const raw = await res.text();
        let data: any;
        try { data = JSON.parse(raw); } catch { throw new Error('The check is unavailable right now. Try again in a minute, or write to info@oper-stack.com.'); }
        if (!data.ok) throw new Error(data.error || 'The check failed');
        last = data; render(data);
        track('ai_visibility_check', { host: data.host, score: data.score, grade: data.grade });
        note.textContent = 'Public signals only. We log the address checked and the score, never your IP.';
      } catch (err: any) {
        out.innerHTML = `<p class="err">${esc(err.message || 'The check failed')}</p>`; out.hidden = false;
        const m2 = document.getElementById('vis-more') as HTMLElement; if (m2) { m2.hidden = true; m2.innerHTML = ''; }
        // Прочитать сайт не вышло, значит отчёта по нему не будет. Форму обмена на почту
        // прячем вместе со старым «Отправили»: иначе на экране остаётся приглашение
        // получить отчёт по ПРЕДЫДУЩЕМУ сайту, и человек думает, что письмо уже ушло.
        capture.hidden = true; pdfMsg.hidden = true; pdfMsg.textContent = '';
        note.textContent = 'Public signals only. We log the address checked and the score, never your IP.';
      } finally { btn.disabled = false; btn.textContent = 'Check the site →'; }
    });

    pdfForm.addEventListener('submit', async (e) => {
      e.preventDefault(); pdfMsg.hidden = true; pdfBtn.disabled = true;
      const fd = new FormData(pdfForm);
      const payload = { name: '', email: fd.get('email'), message: last ? `AI visibility ${last.score}/100 (grade ${last.grade}) for ${last.url}` : 'AI visibility task request', source: pdfSource.value, website: fd.get('website'), page: location.pathname, formLoadedAt: loadedAt, formElapsedMs: Date.now() - loadedAt };
      try {
        // Сначала письмо с задачей: человек пришёл за ней. Лид записываем следом и не роняем
        // ответ, если CRM недоступна: задача уже ушла, и это главное.
        const taskRes = await fetch('/api/visibility-task/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: fd.get('email'), url: last ? last.url : '', website: fd.get('website'), ...origin() }) });
        const taskData = await taskRes.json().catch(() => ({}));
        if (!taskRes.ok) throw new Error(taskData.error || 'Request failed');
        fetch('/api/lead/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) }).catch(() => {});
        track('lead_form_submit', { form_name: 'ai_visibility_task', source: pdfSource.value });
        if (taskData.sent === false) {
          pdfMsg.textContent = taskData.message || 'Nothing is failing on this site.';
          pdfMsg.className = 'msg'; pdfMsg.hidden = false; pdfBtn.disabled = false;
          return;
        }
        /*
         * Остаёмся на странице, как на русской стороне. Уводить человека на отдельную
         * «спасибо» значит забирать у него результат, размытый список и кнопку, ради которых
         * он сюда и пришёл. Подтверждение и что делать дальше говорим на месте.
         */
        /*
         * The confirmation replaces the form instead of sitting under it.
         *
         * The field used to clear, the button re-enabled, and a grey line appeared below. Anyone
         * who looked away for a second came back to an empty form with a live button and read it
         * as "reset", not "sent". On 16.09.2026 two people sent themselves a second letter that way.
         *
         * The form goes away entirely: no form, no second letter. The address is named, which
         * settles the "did it send?" question. The result above is left alone: that is what they
         * came for.
         */
        const sentTo = String(fd.get('email') || '').trim();
        const box = document.getElementById('vis-capture') as HTMLElement;
        box.classList.add('sent');
        // Человек мог увести взгляд или уйти вниз по странице: подводим панель к глазам и
        // объявляем её вслух для тех, кто читает страницу голосом.
        box.setAttribute('role', 'status');
        box.setAttribute('tabindex', '-1');
        try { box.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch { box.scrollIntoView(); }
        setTimeout(() => { try { box.focus({ preventScroll: true }); } catch {} }, 60);
        box.innerHTML = `
          <p class="sent-tick" aria-hidden="true">✓</p>
          <h2>The letter is on its way to ${esc(sentTo)}</h2>
          <p>It arrives within a couple of minutes from <b>info@oper-stack.com</b>.</p>
          <p class="sent-spam">If you do not see it, look in spam and mark it "not spam", and the next ones land in your inbox.</p>
          <p class="note">Inside: the second fix in full and the names of the remaining findings on ${esc(lastHost || '')}.</p>`;
        box.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err: any) { pdfMsg.textContent = err.message || 'Something went wrong. Email info@oper-stack.com'; pdfMsg.className = 'msg err'; pdfMsg.hidden = false; pdfBtn.disabled = false; }
    });
  </script>
</CommercialLayout>

