<!-- Результат проверки вставляется скриптом уже после сборки, поэтому разметка не получает
     метку, по которой Astro ограничивает стили страницы, и правила выше на неё не действуют:
     кольцо со счётом рисовалось чёрным кругом в 722 пикселя вместо 132. Те же правила
     повторены здесь глобально, но с префиксом .result, чтобы они не вышли за карточку. -->
<style is:global>
  /* Подтверждение отправки живёт здесь, а не в области стилей страницы, намеренно.
     Панель собирает скрипт через innerHTML, а Astro приписывает свои правила только той
     разметке, которая была в файле при сборке. Вставленные скриптом галочка и заголовок
     обычных правил не получают вовсе: до этой правки кружок с галочкой не рисовался.
     Селекторы держатся на идентификаторе #vis-capture, поэтому наружу ничего не течёт.

     Панель намеренно не похожа на соседние карточки: человек нажимает кнопку и отводит
     взгляд на телефон, а вернувшись, должен сразу увидеть, что на экране появилось новое. */
  #vis-capture.sent {
    border: 2px solid rgba(61,184,169,.9);
    background: linear-gradient(180deg, rgba(61,184,169,.24), rgba(26,138,125,.10));
    box-shadow: 0 0 0 4px rgba(61,184,169,.14), 0 18px 46px rgba(0,0,0,.45);
    animation: sent-in .4s ease-out both, sent-pulse 1.6s ease-in-out .4s 3;
  }
  #vis-capture.sent:focus { outline: none; }
  #vis-capture.sent .sent-tick {
    display: inline-flex; align-items: center; justify-content: center;
    width: 44px; height: 44px; border-radius: 50%;
    background: #3DB8A9; color: #08121a;
    font-size: 25px; font-weight: 700; line-height: 1; margin: 0 0 14px;
  }
  #vis-capture.sent h2 { margin: 0 0 12px; font-size: 24px; }
  /* Просьба заглянуть в спам. Внутри подтверждения она тонула в остальном тексте, а это самая
     полезная строка на экране: отметка «не спам» учит почтовую службу пропускать следующие
     письма, и без неё человек просто не найдёт того, что заказал. Тёплая подложка отделяет её
     от бирюзы самой панели, не превращая в крик. */
  #vis-capture.sent .sent-spam {
    margin: 0 0 12px;
    padding: 11px 14px;
    border-radius: 10px;
    border-left: 3px solid rgba(232,184,74,.8);
    background: rgba(232,184,74,.15);
    color: var(--paper);
  }
  #vis-capture.sent p { margin: 0 0 10px; }
  @keyframes sent-in { from { opacity: 0; transform: translateY(10px) scale(.985); } to { opacity: 1; transform: none; } }
  @keyframes sent-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(61,184,169,.14), 0 18px 46px rgba(0,0,0,.45); }
    50%      { box-shadow: 0 0 0 11px rgba(61,184,169,.26), 0 18px 46px rgba(0,0,0,.45); }
  }
  /* Кому движение мешает, тому только статичная подсветка: она и так достаточно заметна. */
  @media (prefers-reduced-motion: reduce) { #vis-capture.sent { animation: none; } }

