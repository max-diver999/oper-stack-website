  .ownscore { border-left: 3px solid var(--teal); padding-left: 14px; font-size: 15px; line-height: 1.6; max-width: 68ch; margin: 0 0 22px; color: rgba(245,242,236,.86); }
  .ownscore code { font-family: var(--fm); font-size: 13.5px; background: rgba(0,0,0,.3); padding: 1px 6px; border-radius: 4px; }
  .result .compare { margin-top: 26px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.1); }
