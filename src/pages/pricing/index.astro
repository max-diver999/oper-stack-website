---
import CommercialLayout from '../../components/CommercialLayout.astro';
import CitabilityBlock from '../../components/CitabilityBlock.astro';
import FaqSection from '../../components/FaqSection.astro';
import { SITE } from '../../data/site';

/*
 * Переупаковка 25.09.2026: одна подписка вместо лестницы из пятнадцати продуктов. Разовый аудит
 * за 149 остаётся второй строкой, услуги руками уходят в «по запросу» без кнопок оплаты.
 * На странице обязательно: как отменить, возврат, контакты (нужно и клиенту, и проверке
 * платёжного сервиса).
 */
const canonical = `${SITE.url}/pricing/`;
const WATCH_CHECKOUT = 'https://whop.com/oper-stack/operstack-watch/';
const INCLUDED = [
  'Every week: whether ChatGPT names you for ten questions your buyers ask',
  'Who it names instead of you, by name',
  'Three rivals measured beside you',
  'Your score out of 100 across ten pages, measured again every week',
  'The fix list for your whole site: the page address and the text ready to paste',
  'One email a week: what changed since last week',
];
const FAQ = [
  { question: 'What happens after the 7 days?', answer: 'If you do nothing, the subscription continues at 35 USD a month, or 299 USD a year if you chose yearly. Cancel before day 7 and you pay nothing.' },
  { question: 'How do I cancel?', answer: 'In your Whop account, in one click, at any time. You keep access until the end of the period you paid for, and the weekly letters stop after that.' },
  { question: 'Can I get a refund?', answer: 'The 7 free days are there so you can decide before paying. After a charge, write to info@oper-stack.com within 7 days and we refund it. The full rules are on the refunds page.' },
  { question: 'Where do the ChatGPT answers come from?', answer: 'We ask ChatGPT with web search switched on, the same way each week, in three wordings for each question. An answer can differ from one run to the next, so we show the date and the trend rather than a single verdict.' },
  { question: 'Do I need Claude, Cursor or a developer?', answer: 'No. The report is on the site and in your inbox. Most fixes are text you paste into your site; the few that need a developer are marked so you can forward them.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
};
---

<CommercialLayout
  title={`Pricing · ${SITE.name}`}
  description="OperStack Watch: 35 USD a month or 299 USD a year, 7 days free. Every week, whether ChatGPT names you, who it names instead, and what to fix. One-off audit 149 USD."
  canonical={canonical}
  jsonLd={faqSchema}
>
  <div class="wrap wide">
    <h1>One plan. Seven days free.</h1>
    <p class="lede">The free check tells you what AI sees on your site today. Watch tells you every week whether ChatGPT names you, who it names instead, and what to change.</p>

    <CitabilityBlock
      text="OperStack Watch costs 35 USD a month or 299 USD a year, with the first 7 days free. It asks ChatGPT ten of your buyers' questions every week, shows who it names instead of you, measures three rivals beside you, and sends the fixes for your site by email. A one-off audit is 149 USD."
    />

    <article class="watch">
      <div class="watch-head">
        <h2>OperStack Watch</h2>
        <div class="period" role="group" aria-label="Billing period">
          <button type="button" class="on" data-p="m">Monthly</button>
          <button type="button" data-p="y">Yearly</button>
        </div>
      </div>
      <p class="price"><span data-show="m">35 USD <small>a month</small></span><span data-show="y" hidden>299 USD <small>a year, about 25 a month</small></span></p>
      <p class="price-note">7 days free, then billed unless you cancel. Cancel any time.</p>
      <ul>{INCLUDED.map((f) => <li>{f}</li>)}</ul>
      <a class="btn" href={WATCH_CHECKOUT} target="_blank" rel="noopener">Start 7 days free →</a>
      <p class="fine">Card required at checkout. Secure checkout by Whop.</p>
    </article>

    <section class="alt">
      <div>
        <h2>Prefer to pay once?</h2>
        <p>A full audit of your site: a hundred pages, five rivals, ready files to put on the site, reviewed by a person. No subscription.</p>
        <p><a href="/products/seo-audit/">Full audit, 149 USD →</a></p>
      </div>
      <div>
        <h2>Need it done for you?</h2>
        <p>Fixes on your site and setup work are quoted on request, after we agree the list in writing.</p>
        <p><a href="/services/">Services on request →</a></p>
      </div>
    </section>

    <section class="rules">
      <h2>Cancelling, refunds, contact</h2>
      <p>Cancel in your Whop account at any time. Refunds within 7 days of a charge: <a href="/refunds/">refund policy</a>. Terms: <a href="/terms/">terms of service</a>. Privacy: <a href="/privacy/">privacy policy</a>. Questions: <a href="mailto:info@oper-stack.com">info@oper-stack.com</a>, Maksim Shchegolev.</p>
      <p class="muted-line">Free tools and one-off products: <a href="/products/">all products</a>.</p>
    </section>

    <FaqSection items={FAQ} />
  </div>
</CommercialLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.period button').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.period button').forEach((x) => x.classList.toggle('on', x === b));
      document.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => { el.hidden = el.dataset.show !== b.dataset.p; });
    });
  });
</script>

<style>
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin: 32px 0 40px;
  }
  @media (max-width: 860px) {
    .tiers { grid-template-columns: 1fr; }
  }
  .tier {
    padding: 24px 22px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tier.featured {
    border-color: rgba(61, 184, 169, 0.4);
    background: rgba(61, 184, 169, 0.06);
    box-shadow: 0 20px 50px -30px rgba(61, 184, 169, 0.35);
  }
  .badge {
    font-family: var(--fm);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--teal-soft);
  }
  .tier h2 {
    font-family: var(--fd);
    font-size: 22px;
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 4px;
  }
  .price {
    font-family: var(--fd);
    font-size: 28px;
    color: var(--amber-soft);
    margin: 4px 0;
  }
  .price-note {
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 8px;
  }
  .tier ul {
    list-style: none;
    margin: 8px 0 16px;
    flex: 1;
  }
  .tier li {
    font-size: 13px;
    color: rgba(245, 242, 236, 0.82);
    padding-left: 16px;
    position: relative;
    margin-bottom: 8px;
  }
  .tier li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 8px;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--teal);
  }
  .includes {
    margin: 40px 0;
    padding: 24px;
    border-radius: 14px;
    border: 1px solid rgba(255, 255, 255, 0.07);
  }
  .includes h2 {
    font-family: var(--fd);
    font-size: 22px;
    margin-bottom: 14px;
  }
  .includes ul {
    list-style: none;
    display: grid;
    gap: 10px;
  }
  .includes li {
    font-size: 14px;
    color: rgba(245, 242, 236, 0.85);
    padding-left: 18px;
    position: relative;
  }
  .includes li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--teal-soft);
  }
  .proof-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 0 0 40px;
    padding: 22px 24px;
    border-radius: 14px;
    border: 1px solid rgba(61, 184, 169, 0.28);
    background: linear-gradient(135deg, rgba(61, 184, 169, 0.1), rgba(232, 184, 74, 0.06));
  }
  .shelf { margin: 48px 0 8px; }
  .shelf-lede { color: var(--muted); max-width: 62ch; margin: 8px 0 18px; }
  .shelf-list { list-style: none; padding: 0; margin: 0 0 20px; display: grid; gap: 10px; }
  .shelf-list li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 4px 14px;
    padding: 12px 14px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.02);
  }
  .shelf-list a { font-weight: 600; text-decoration: none; }
  .shelf-price { font-family: var(--fm); font-size: 14px; color: var(--amber-soft); white-space: nowrap; }
  .shelf-note { grid-column: 1 / -1; font-size: 13px; color: var(--muted); }
  @media (max-width: 680px) {
    .shelf-list li { grid-template-columns: 1fr; padding: 6px 14px; }
    /* По ссылке в полке бьют пальцем: строке текста нужна высота, а не только подчёркивание. */
    .shelf-list a { display: inline-flex; align-items: center; min-height: 40px; }
    .shelf-price { font-size: 15px; }
    .shelf-note { font-size: 14px; padding-bottom: 8px; }
  }

  .proof-eyebrow {
    font-family: var(--fm);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-soft);
    margin-bottom: 8px;
  }
  .proof-stat {
    font-family: var(--fd);
    font-size: clamp(18px, 3vw, 22px);
    letter-spacing: -0.02em;
    color: var(--paper);
    max-width: 36ch;
    line-height: 1.25;
  }
  .proof-note {
    margin-top: 8px;
    font-size: 12px;
    color: var(--muted);
    max-width: 42ch;
  }
  .proof-btn {
    flex-shrink: 0;
    white-space: nowrap;
  }
  .guides-cta h2 {
    font-family: var(--fd);
    font-size: 22px;
    margin-bottom: 8px;
  }
  .guides-cta p {
    color: var(--muted);
    font-size: 15px;
  }

  /* Телефон: двенадцать пикселей на пояснении к цене читаются с трудом. */
  @media (max-width: 680px) {
    .price-note, .proof-note { font-size: 14px; line-height: 1.5; }
    .proof-eyebrow { font-size: 11px; }
  }
  /* Переупаковка 25.09.2026 */
  .watch { max-width: 560px; margin: 32px 0 40px; padding: 28px 26px; border-radius: 18px; border: 1px solid rgba(61,184,169,.45); background: rgba(61,184,169,.06); box-shadow: 0 20px 50px -30px rgba(61,184,169,.35); display: flex; flex-direction: column; gap: 10px; }
  .watch-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .watch h2 { margin: 0; font-size: 24px; }
  .period { display: inline-flex; border: 1px solid rgba(255,255,255,.12); border-radius: 999px; padding: 3px; }
  .period button { background: none; border: 0; color: var(--muted); font: inherit; font-size: 13px; padding: 6px 14px; border-radius: 999px; cursor: pointer; }
  .period button.on { background: rgba(61,184,169,.18); color: var(--paper); }
  .watch .price { font-size: 38px; margin: 6px 0 0; }
  .watch .price small { font-size: 15px; color: var(--muted); font-weight: 400; }
  .watch ul { list-style: none; padding: 0; margin: 10px 0 8px; display: grid; gap: 8px; }
  .watch li { padding-left: 22px; position: relative; font-size: 15px; }
  .watch li::before { content: '✓'; position: absolute; left: 0; color: var(--teal-soft); }
  .watch .btn { align-self: flex-start; margin-top: 6px; }
  .fine { font-size: 13px; color: var(--muted); margin: 4px 0 0; }
  .alt { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 8px 0 36px; }
  .alt > div { padding: 20px; border-radius: 14px; border: 1px solid rgba(255,255,255,.08); background: rgba(255,255,255,.02); }
  .alt h2 { font-size: 18px; margin: 0 0 6px; }
  .alt p { margin: 0 0 8px; color: var(--muted); font-size: 15px; }
  .rules { margin: 0 0 36px; max-width: 70ch; }
  .rules h2 { font-size: 18px; margin: 0 0 8px; }
  .rules p { color: var(--muted); font-size: 15px; }
  .muted-line { margin-top: 10px; }
  @media (max-width: 680px) { .alt { grid-template-columns: 1fr; } .watch { padding: 22px 18px; } }
</style>
