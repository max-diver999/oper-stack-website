---
import CommercialLayout from '../../components/CommercialLayout.astro';
import CitabilityBlock from '../../components/CitabilityBlock.astro';
import FaqSection from '../../components/FaqSection.astro';
import { SITE } from '../../data/site';

/*
 * Переупаковка 25.09.2026: одна подписка вместо лестницы из пятнадцати продуктов. Разовый аудит
 * за 149 остаётся второй строкой, услуги руками уходят в «по запросу» без кнопок оплаты.
 * На странице обязательно: как отменить, возврат, контакты (нужно и клиенту, и проверке
 * платёжного сервиса).
 */
const canonical = `${SITE.url}/pricing/`;
const WATCH_CHECKOUT = 'https://whop.com/oper-stack/operstack-watch/';
const INCLUDED = [
  'Every week: whether ChatGPT names you for ten questions your buyers ask',
  'Who it names instead of you, by name',
  'Three rivals measured beside you',
  'Your score out of 100 across ten pages, measured again every week',
  'The fix list for your whole site: the page address and the text ready to paste',
  'One email a week: what changed since last week',
];
const FAQ = [
  { question: 'What happens after the 7 days?', answer: 'If you do nothing, the subscription continues at $35 a month, or $299 a year if you chose yearly. Cancel before day 7 and you pay nothing.' },
  { question: 'How do I cancel?', answer: 'Cancel any time: every Watch email carries the link. Cancel within the first 7 days and you pay nothing. Cancel later and you are not charged again; the weekly letters run to the end of the period you paid for.' },
  { question: 'Where do the ChatGPT answers come from?', answer: 'We ask ChatGPT with web search switched on, the same ten questions each week. An answer can differ from one run to the next, so we show the date and the trend rather than a single verdict.' },
  { question: 'Do I need Claude, Cursor or a developer?', answer: 'No. The report is on the site and in your inbox. Most fixes are text you paste into your site; the few that need a developer are marked so you can forward them.' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
};
---

<CommercialLayout
  theme="light"
  title={`Pricing · ${SITE.name}`}
  description="OperStack Watch: $35 a month or $299 a year, 7 days free. Every week, whether ChatGPT names you, who it names instead, and what to fix. One-off audit $149."
  canonical={canonical}
  jsonLd={faqSchema}
>
  <div class="wrap wide">
    <h1>One plan. Seven days free.</h1>
    <p class="lede">The free check tells you what AI sees on your site today. Watch tells you every week whether ChatGPT names you, who it names instead, and what to change.</p>

    <CitabilityBlock
      text="OperStack Watch costs $35 a month or $299 a year, with the first 7 days free. It asks ChatGPT ten of your buyers' questions every week, shows who it names instead of you, measures three rivals beside you, and sends the fixes for your site by email. A one-off audit is $149."
    />

    <article class="watch">
      <div class="watch-head">
        <h2>OperStack Watch</h2>
        <div class="period" role="group" aria-label="Billing period">
          <button type="button" class="on" data-p="m">Monthly</button>
          <button type="button" data-p="y">Yearly</button>
        </div>
      </div>
      <p class="price"><span data-show="m">$35 <small>a month</small></span><span data-show="y" hidden>$299 <small>a year, about $25 a month</small></span></p>
      <p class="price-note">7 days free, then billed unless you cancel. Cancel any time.</p>
      <ul>{INCLUDED.map((f) => <li>{f}</li>)}</ul>
      <a class="btn" href={WATCH_CHECKOUT} target="_blank" rel="noopener">Start 7 days free →</a>
      <p class="fine">Card required at checkout. Secure checkout by Whop.</p>
    </article>

    <section class="alt">
      <div>
        <h2>Prefer to pay once?</h2>
        <p>A full audit of your site: a hundred pages, five rivals, ready files to put on the site, reviewed by a person. No subscription.</p>
        <p><a href="/products/seo-audit/">Full audit, $149 →</a></p>
      </div>
      <div>
        <h2>Need it done for you?</h2>
        <p>Fixes on your site and setup work are quoted on request, after we agree the list in writing.</p>
        <p><a href="/services/">Services on request →</a></p>
      </div>
    </section>

    <section class="rules">
      <h2>Cancelling and contact</h2>
      <p>Cancel any time. Within the first 7 days you pay nothing; after that you are not charged again. <a href="/refunds/">Refund policy</a> · <a href="/terms/">Terms of service</a> · <a href="/privacy/">Privacy policy</a>. Questions: <a href="mailto:info@oper-stack.com">info@oper-stack.com</a>, Maksim Shchegolev.</p>
      <p class="muted-line">Free tools and one-off products: <a href="/products/">all products</a>.</p>
    </section>

    <FaqSection items={FAQ} />
  </div>
</CommercialLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('.period button').forEach((b) => {
    b.addEventListener('click', () => {
      document.querySelectorAll('.period button').forEach((x) => x.classList.toggle('on', x === b));
      document.querySelectorAll<HTMLElement>('[data-show]').forEach((el) => { el.hidden = el.dataset.show !== b.dataset.p; });
    });
  });
</script>

<style>
  .wrap { max-width: 1080px; }
  .wrap h1 { font-family: var(--fd); font-weight: 600; font-size: clamp(34px, 5.4vw, 54px); letter-spacing: -.025em; line-height: 1.05; margin: 36px 0 14px; }
  .wrap > .lede { font-size: 18px; color: #3F4854; max-width: 60ch; }
  .watch { max-width: 580px; margin: 32px 0 40px; padding: 30px 28px; border-radius: 22px; border: 1px solid rgba(26,138,125,.35); background: #fff; box-shadow: 0 1px 2px rgba(11,16,23,.04), 0 24px 60px -30px rgba(26,138,125,.45); display: flex; flex-direction: column; gap: 10px; }
  .watch-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .watch h2 { margin: 0; font-family: var(--fd); font-size: 28px; font-weight: 600; letter-spacing: -.01em; }
  .period { display: inline-flex; border: 1px solid rgba(11,16,23,.12); border-radius: 999px; padding: 3px; background: #FAF8F4; }
  .period button { background: none; border: 0; color: #6B7480; font: inherit; font-size: 13.5px; padding: 6px 14px; border-radius: 999px; cursor: pointer; }
  .period button.on { background: #1A8A7D; color: #fff; }
  .watch .price { font-family: var(--fd); font-weight: 600; font-size: 46px; margin: 8px 0 0; color: #0B1017; letter-spacing: -.02em; }
  .watch .price small { font-family: var(--fb); font-size: 15px; color: #6B7480; font-weight: 400; letter-spacing: 0; }
  .price-note { margin: 0; color: #3F4854; font-size: 15px; }
  .watch ul { list-style: none; padding: 0; margin: 12px 0 10px; display: grid; gap: 10px; }
  .watch li { padding-left: 26px; position: relative; font-size: 15.5px; color: #0B1017; line-height: 1.45; }
  .watch li::before { content: '✓'; position: absolute; left: 0; top: 0; width: 18px; height: 18px; border-radius: 50%; background: #E6F4F1; color: #1A8A7D; font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; }
  .watch .btn { align-self: stretch; justify-content: center; margin-top: 8px; padding: 15px 20px; border-radius: 12px; font-size: 16px; background: #1A8A7D; }
  .watch .btn:hover { background: #157468; filter: none; }
  .fine { font-size: 13px; color: #6B7480; margin: 4px 0 0; text-align: center; }
  .alt { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 8px 0 36px; }
  .alt > div { padding: 22px; border-radius: 18px; border: 1px solid rgba(11,16,23,.09); background: #fff; box-shadow: 0 1px 2px rgba(11,16,23,.03), 0 12px 32px -22px rgba(11,16,23,.22); }
  .alt h2 { font-family: var(--fd); font-size: 21px; margin: 0 0 6px; }
  .alt p { margin: 0 0 8px; color: #3F4854; font-size: 15px; }
  .alt a { font-weight: 600; }
  .rules { margin: 0 0 36px; max-width: 72ch; }
  .rules h2 { font-family: var(--fd); font-size: 21px; margin: 0 0 8px; }
  .rules p { color: #3F4854; font-size: 15px; }
  .muted-line { margin-top: 10px; }
  @media (max-width: 680px) { .alt { grid-template-columns: 1fr; } .watch { padding: 24px 18px; } .wrap h1 { margin-top: 24px; } }
</style>
