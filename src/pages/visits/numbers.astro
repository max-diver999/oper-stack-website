---
/**
 * The answer to the question the whole funnel asks: how many people did each assistant send you.
 *
 * The private link is the only credential, so this page is never indexed and never cached. It reads
 * its own token from the address bar and asks the report endpoint; nothing is rendered on the
 * server, so the token never sits in a build artefact.
 */
import CommercialLayout from '../../components/CommercialLayout.astro';
import { SITE } from '../../data/site';

export const prerender = false;

/** The Russian site sells the same counter, and a Russian owner should not land on English. */
const ru = Astro.url.searchParams.get('lang') === 'ru';

const T = ru
  ? {
      title: 'Ваши визиты из ИИ · OperStack',
      description: 'Сколько людей прислал вам каждый ИИ-ассистент.',
      label: 'Ваши числа',
      h1: 'Кто присылал вам посетителей',
      loading: 'Читаем ваш счётчик…',
      emptyH: 'Пока ничего не насчитано',
      emptyP: 'У этого две совершенно разные причины, и гадать вам не нужно. Мы посмотрим ваш сайт и скажем, какая именно.',
      checkBtn: 'Проверить, стоит ли строчка на сайте',
      emptySmall: 'Ваши собственные заходы на сайт не считаются: вы пришли не от ассистента.',
      failH: 'Эта ссылка ничего не открывает',
      failP: 'Либо в ней опечатка, либо она не наша. Ссылку мы присылали письмом, когда вы заводили счётчик. Если не находите её, напишите нам с того же адреса, и мы пришлём заново.',
      keepH: 'Сохраните эту ссылку',
      keepP: 'Это единственный путь к вашим числам, и любой, у кого она есть, их увидит. Пароля нет, потому что здесь нечего защищать паролем: ни один посетитель не опознан, адреса не хранятся, страницы не записываются. Только имя ассистента, день и количество.',
      nextP: 'Когда число известно, бесплатная проверка видимости скажет, может ли вас вообще процитировать ответная система, а список исправлений за 9 долларов превратит каждый пробел в задачу, которую можно отдать кому угодно.',
      nextCheck: 'бесплатная проверка видимости',
      nextFix: 'список исправлений за 9 долларов',
    }
  : {
      title: 'Your AI visits · OperStack',
      description: 'How many people each AI assistant sent to your site.',
      label: 'Your numbers',
      h1: 'Who sent you visitors',
      loading: 'Reading your counter…',
      emptyH: 'Nothing counted yet',
      emptyP: 'That has two very different causes, and you should not have to guess which. We can look at your site and tell you.',
      checkBtn: 'Check the line is on my site',
      emptySmall: 'Nothing is counted from you browsing your own site, because you did not arrive from an assistant.',
      failH: 'This link does not open anything',
      failP: 'Either it was mistyped, or it is not one of ours. The link was emailed to you when you set the counter up. If you cannot find it, write to us from the same address and we will send it again.',
      keepH: 'Keep this link',
      keepP: 'It is the only way to your numbers, and anyone who has it can see them. There is no password because there is nothing here worth a password: no visitor is identified, no address is stored, and no page is recorded. Only which assistant, which day, and how many.',
      nextP: 'Once you know the number, the free visibility check says whether an answer engine can quote you in the first place, and the 9 USD fix list turns every gap into a task you can hand to anyone.',
      nextCheck: 'free visibility check',
      nextFix: '9 USD fix list',
    };

/** Everything the browser renders after the numbers arrive. */
const JS_STRINGS = ru
  ? {
      missing: 'В этом адресе нет ссылки.',
      whoSent: 'Кто присылал посетителей на ',
      countingSince: 'Считаем с ',
      twoHalves: 'Два числа про один и тот же сайт',
      halfVisits: 'Сколько людей пришло',
      halfScore: 'Могут ли вас процитировать',
      scoreOf: 'из 100',
      inDays: 'за {d} дн.',
      scoreNone: 'Оценку пока не сняли.',
      moveUp: 'выросла на ', moveDown: 'упала на ', moveSame: 'не изменилась',
      sinceDay: ' с ',
      areasH: 'Из чего складывается оценка',
      whyBoth: 'Счётчик говорит, сколько людей пришло. Оценка говорит, могут ли вас вообще процитировать. Сайт, который нельзя процитировать, визитов и не получит, а визиты без понимания причины нельзя повторить.',
      fixLink: 'Что чинить первым',
      visitsOne: 'визит', visitsFew: 'визита', visitsMany: 'визитов',
      visitsLine: '{n} {w} от ИИ-ассистентов за последние {d} дней.',
      thAssistant: 'Ассистент', thVisits: 'Визитов', thShare: 'Доля',
      lastVisit: 'Последний визит: ',
      looking: 'Смотрим ваш сайт…',
      cantLook: 'Сейчас посмотреть не получилось. Попробуйте через минуту.',
      installedOk: 'Строчка на {d} стоит и работает. Вы просто ждёте: визит засчитывается, когда человек читает ответ ассистента и переходит к вам. На небольшом сайте это дни, а не минуты.',
      installedNo: 'Строчки на {d} нет. Поэтому ничего и не считается. Вставьте её в шапку сайта на всех страницах и опубликуйте. Строчка есть в письме, которое мы вам прислали.',
      wrongKeyTail: ' Замените её на строчку из вашего письма, ту, что заканчивается вашим ключом.',
      wrongKeyHead: 'Строчка стоит, но с чужим ключом, поэтому визиты считаются не вам.',
      rWalled: 'Ваш сайт не пускает автоматических читателей, поэтому снаружи мы посмотреть не можем. Эту проверку придётся сделать самому.',
      rStatus: 'Сайт ответил ошибкой, поэтому посмотреть не удалось.',
      rTimeout: 'Сайт отвечал слишком долго.',
      rNoanswer: 'Сайт не ответил.',
      rUnknown: 'Посмотреть ваш сайт отсюда не вышло, эту проверку придётся сделать самому.',
    }
  : {
      missing: 'This address is missing its link.',
      whoSent: 'Who sent visitors to ',
      countingSince: 'Counting since ',
      twoHalves: 'Two numbers about the same site',
      halfVisits: 'How many people arrived',
      halfScore: 'Whether you can be quoted',
      scoreOf: 'of 100',
      inDays: 'in {d} days',
      scoreNone: 'No score taken yet.',
      moveUp: 'up ', moveDown: 'down ', moveSame: 'unchanged',
      sinceDay: ' since ',
      areasH: 'What the score is made of',
      whyBoth: 'The counter says how many people arrived. The score says whether anybody can quote you at all. A site nobody can quote will never have visits to count, and visits with no idea why cannot be repeated.',
      fixLink: 'What to fix first',
      visitsOne: 'visit', visitsFew: 'visits', visitsMany: 'visits',
      visitsLine: '{n} {w} from AI assistants in the last {d} days.',
      thAssistant: 'Assistant', thVisits: 'Visits', thShare: 'Share',
      lastVisit: 'Most recent visit: ',
      looking: 'Looking at your site…',
      cantLook: 'We could not look just now. Try again in a minute.',
      installedOk: 'The line is on {d} and working. You are simply waiting: a visit is counted when somebody reads an answer from an assistant and clicks through to you. On a small site that is days, not minutes.',
      installedNo: 'The line is not on {d}. That is why nothing is counted. Paste it into the head of your site, on every page, and publish. The line is in the email we sent you.',
      wrongKeyTail: ' Replace it with the line from your email, the one ending in your own key.',
      wrongKeyHead: 'The line is there, but it carries a different key, so the visits are being counted somewhere else.',
      rWalled: 'Your site turns away automated readers, so we cannot look from outside. This one you will have to check yourself.',
      rStatus: 'The site answered with an error, so we could not look.',
      rTimeout: 'The site took too long to answer.',
      rNoanswer: 'The site did not answer.',
      rUnknown: 'We could not look at your site from here, so this one you will have to check yourself.',
    };
---

<CommercialLayout
  title={T.title}
  description={T.description}
  canonical={`${SITE.url}/visits/numbers/`}
  noindex={true}
  bare={ru
    ? { home: 'https://oper-stack.ru/vizity/', label: '← Счётчик визитов из ИИ', footer: 'OperStack · счётчик визитов из ИИ' }
    : { home: '/visits/', label: '← AI visit counter', footer: 'OperStack · the AI visit counter' }}
>
  <div class="wrap">
    <p class="label">{T.label}</p>
    <h1 id="head">{T.h1}</h1>
    <p class="lede" id="sub">{T.loading}</p>

    <section id="both" hidden></section>
    <section id="out" hidden></section>

    <section id="empty" hidden>
      <h2>{T.emptyH}</h2>
      <p>{T.emptyP}</p>
      <p><button type="button" class="btn" id="check">{T.checkBtn}</button></p>
      <p class="verdict" id="verdict" hidden></p>
      <p class="small">{T.emptySmall}</p>
    </section>

    <section id="fail" hidden>
      <h2>{T.failH}</h2>
      <p>{T.failP} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
    </section>

    <section class="keep">
      <h2>{T.keepH}</h2>
      <p>{T.keepP}</p>
      <p class="next" set:html={T.nextP
        .replace(T.nextCheck, `<a href="/ai-visibility/">${T.nextCheck}</a>`)
        .replace(T.nextFix, `<a href="/products/site-report/">${T.nextFix}</a>`)} />
    </section>
  </div>
</CommercialLayout>

<script is:inline define:vars={{ S: JS_STRINGS }}>
  (function () {
    var token = new URLSearchParams(location.search).get('t') || '';
    var sub = document.getElementById('sub');
    var out = document.getElementById('out');
    var empty = document.getElementById('empty');
    var fail = document.getElementById('fail');

    function esc(s) {
      return String(s).replace(/[<>&"]/g, function (c) {
        return { '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' }[c];
      });
    }

    function show(el) { el.hidden = false; }

    function plural(n) {
      var m10 = n % 10, m100 = n % 100;
      if (m10 === 1 && m100 !== 11) return S.visitsOne;
      if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return S.visitsFew;
      return S.visitsMany;
    }

    if (!token) { sub.textContent = S.missing; show(fail); return; }

    /** Both halves in one place, each with how it moved. */
    function renderBoth(d) {
      var both = document.getElementById('both');
      var sc = d.score;
      var before = d.scoreBefore;

      var move = '';
      if (sc && before) {
        var diff = sc.score - before.score;
        move = diff === 0 ? S.moveSame
          : (diff > 0 ? S.moveUp : S.moveDown) + Math.abs(diff) + S.sinceDay + new Date(before.day).toLocaleDateString();
      }

      var areas = sc && sc.areas && sc.areas.length
        ? '<div class="areas"><p class="areas-h">' + S.areasH + '</p><ul>' +
          sc.areas.map(function (a) {
            var pct = Math.round((a.score / a.max) * 100);
            return '<li><span class="a-name">' + esc(a.label) + '</span>' +
              '<span class="a-bar"><i style="width:' + pct + '%"></i></span>' +
              '<span class="a-num">' + a.score + '/' + a.max + '</span></li>';
          }).join('') + '</ul></div>'
        : '';

      both.innerHTML =
        '<h2>' + S.twoHalves + '</h2>' +
        '<div class="halves">' +
          '<div class="half"><span class="h-k">' + S.halfVisits + '</span>' +
            '<span class="h-n">' + d.total + '</span>' +
            '<span class="h-s">' + (d.days ? S.inDays.replace('{d}', d.days) : '') + '</span>' +
          '</div>' +
          '<div class="half"><span class="h-k">' + S.halfScore + '</span>' +
            '<span class="h-n">' + (sc ? sc.score : '—') + '</span>' +
            '<span class="h-s">' + (sc ? S.scoreOf + (move ? ' · ' + esc(move) : '') : S.scoreNone) + '</span>' +
          '</div>' +
        '</div>' + areas +
        '<p class="why">' + S.whyBoth + ' <a href="/ai-visibility/">' + S.fixLink + '</a></p>';
      both.hidden = false;
    }

    function wireCheck() {
      var btn = document.getElementById('check');
      var verdict = document.getElementById('verdict');
      btn.addEventListener('click', async function () {
        btn.disabled = true;
        verdict.hidden = false;
        verdict.className = 'verdict';
        verdict.textContent = S.looking;
        try {
          var r = await fetch('/api/visits/installed/?t=' + encodeURIComponent(token));
          var d = await r.json();
          if (!r.ok) { verdict.textContent = d.error || S.cantLook; btn.disabled = false; return; }
          if (d.installed === true) {
            verdict.className = 'verdict ok';
            verdict.textContent = S.installedOk.replace('{d}', d.domain);
          } else if (d.installed === false && d.wrongKey) {
            verdict.className = 'verdict bad';
            verdict.textContent = S.wrongKeyHead + S.wrongKeyTail;
          } else if (d.installed === false) {
            verdict.className = 'verdict bad';
            verdict.textContent = S.installedNo.replace('{d}', d.domain);
          } else {
            var byCode = { walled: S.rWalled, status: S.rStatus, timeout: S.rTimeout, noanswer: S.rNoanswer };
            verdict.textContent = byCode[d.code] || S.rUnknown;
          }
        } catch (err) {
          verdict.textContent = S.cantLook;
        }
        btn.disabled = false;
      });
    }

    fetch('/api/visits/report/?t=' + encodeURIComponent(token) + '&days=90')
      .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, d: d }; }); })
      .then(function (res) {
        if (!res.ok) { sub.textContent = ''; show(fail); return; }
        var d = res.d;
        document.getElementById('head').textContent = S.whoSent + d.domain;

        renderBoth(d);

        if (!d.total) {
          sub.textContent = S.countingSince + new Date(d.installedAt).toLocaleDateString();
          show(empty);
          wireCheck();
          return;
        }

        sub.textContent = S.visitsLine
          .replace('{n}', d.total).replace('{w}', plural(d.total)).replace('{d}', d.days);

        var rows = d.byAssistant.map(function (a) {
          var share = Math.round((a.hits / d.total) * 100);
          return '<tr><td>' + esc(a.assistant) + '</td><td class="n">' + a.hits +
            '</td><td class="n muted">' + share + '%</td></tr>';
        }).join('');

        var last = d.lastVisitAt
          ? '<p class="small">' + S.lastVisit + esc(new Date(d.lastVisitAt).toLocaleString()) + '.</p>'
          : '';

        out.innerHTML =
          '<div class="tablewrap"><table><thead><tr><th>' + S.thAssistant + '</th><th class="n">' + S.thVisits + '</th>' +
          '<th class="n">' + S.thShare + '</th></tr></thead><tbody>' + rows + '</tbody></table></div>' + last;
        show(out);
      })
      .catch(function () { sub.textContent = ''; show(fail); });
  })();
</script>

<style>
  .wrap { max-width: 820px; margin: 0 auto; padding: 40px 20px 80px; }
  .label { font-family: var(--fm); font-size: 10px; letter-spacing: .14em; text-transform: uppercase; color: var(--teal-soft); }
  h1 { font-family: var(--fd); font-size: clamp(26px, 5vw, 36px); letter-spacing: -.02em; margin: 8px 0 0; }
  .lede { font-size: 18px; color: rgba(245,242,236,.86); max-width: 62ch; margin: 14px 0 24px; }
  h2 { font-family: var(--fd); font-size: 22px; margin: 36px 0 10px; }
  p { max-width: 68ch; }
  ol { padding-left: 20px; max-width: 68ch; }
  li { margin: 9px 0; }
  .small { font-size: 14px; color: var(--muted); }
  code { font-family: var(--fm); font-size: 13.5px; background: rgba(0,0,0,.3); padding: 1px 6px; border-radius: 4px; }
  .keep { border-top: 1px solid rgba(255,255,255,.1); margin-top: 44px; padding-top: 20px; }
  .next { margin-top: 16px; }
  .next a, .keep a { color: var(--teal-soft); }
  .verdict { font-size: 15.5px; line-height: 1.55; max-width: 68ch; border-left: 3px solid rgba(255,255,255,.2); padding-left: 14px; }
  .verdict.ok { border-left-color: var(--teal); }
  .verdict.bad { border-left-color: var(--amber-soft); }

</style>

<!-- The table is built in the browser, and Astro scopes styles to markup it rendered itself. -->
<style is:global>
  #both h2 { margin-top: 0; }
  #both .halves { display: flex; flex-wrap: wrap; gap: 12px; margin: 0 0 18px; }
  #both .half { flex: 1 1 200px; border: 1px solid rgba(255,255,255,.09); border-radius: 12px; padding: 14px 16px; background: rgba(255,255,255,.02); }
  #both .h-k { display: block; font-family: var(--fm); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  #both .h-n { display: block; font-family: var(--fd); font-size: 34px; line-height: 1.1; margin: 6px 0 2px; color: var(--amber-soft); font-variant-numeric: tabular-nums; }
  #both .h-s { display: block; font-size: 13px; color: var(--muted); }
  #both .areas-h { font-family: var(--fm); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); margin: 0 0 8px; }
  #both .areas ul { list-style: none; padding: 0; margin: 0; }
  #both .areas li { display: flex; align-items: center; gap: 10px; margin: 6px 0; font-size: 14px; }
  #both .a-name { flex: 1 1 auto; min-width: 0; }
  #both .a-bar { flex: 0 0 90px; height: 6px; border-radius: 99px; background: rgba(255,255,255,.08); overflow: hidden; }
  #both .a-bar i { display: block; height: 100%; background: var(--teal); }
  #both .a-num { flex: 0 0 46px; text-align: right; font-variant-numeric: tabular-nums; color: var(--muted); }
  #both .why { font-size: 14.5px; color: var(--muted); max-width: 68ch; margin-top: 16px; }
  #both .why a { color: var(--teal-soft); }

  #out .tablewrap { overflow-x: auto; border: 1px solid rgba(255, 255, 255, .09); border-radius: 12px; }
  #out table { width: 100%; border-collapse: collapse; font-size: 15.5px; }
  #out th, #out td { padding: 11px 14px; text-align: left; border-bottom: 1px solid rgba(255, 255, 255, .06); }
  #out tbody tr:last-child td { border-bottom: 0; }
  #out th { font-family: var(--fm); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  #out td.n, #out th.n { text-align: right; font-variant-numeric: tabular-nums; }
  #out td.muted { color: var(--muted); }
  #out .small { font-size: 14px; color: var(--muted); margin-top: 12px; }
</style>
