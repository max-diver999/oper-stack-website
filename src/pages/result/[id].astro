---
/**
 * The permanent address of one check. This IS the result: the check form opens it straight away.
 *
 * In plain words. Until 17 Sep 2026 the result was drawn by script on the form page, and this page
 * was a link saying "here is your address, open it if you like". Now it is the other way round: the
 * check ends by landing here, the way every rival does it, and this is the only place the result is
 * drawn. One renderer instead of two, so they cannot drift apart.
 *
 * Why this page is light when the whole site is dark. It is a document somebody reads, forwards and
 * reopens in a week to compare, not a storefront. On a dark ground with one teal accent the blocks
 * merged into each other, and the owner put it plainly: "everything is gloomy, black, one colour,
 * nothing separates, you cannot tell what is where". Here it is paper, white cards with a border,
 * and colour by value: good in teal, middling in amber, poor in coral. One rule for the whole page,
 * from the grade tile down to the bars.
 *
 * The page is kept out of search on purpose: these are other people's sites and their scores, and
 * they have no business surfacing under somebody else's name.
 */
import CommercialLayout from '../../components/CommercialLayout.astro';
import { loadCheck, latestForDomain } from '../../lib/check-store';
import { BADGE_LABEL, badgeSize } from '../../lib/badge';
import { SITE } from '../../data/site';
import { PRODUCTS } from '../../data/products';
import { getExtras } from '../../lib/extras-store';
import { pickPage, FREE_RUNS_PER_IP } from '../../lib/free-extras.mjs';

export const prerender = false;

const id = String(Astro.params.id || '');
const stored = await loadCheck(id);
if (!stored) return Astro.redirect('/ai-visibility/', 302);

const current = await latestForDomain(stored.domain, stored.lang);
const moved = current && current.id !== stored.id && current.score !== stored.score ? current : null;

const p: any = stored.payload || {};
const areas: any[] = Array.isArray(p.areas) ? p.areas : [];
const rest: any[] = Array.isArray(p.rest) ? p.rest : [];
const sample: any[] = Array.isArray(p.sample) ? p.sample : [];
const crawlers: any[] = Array.isArray(p.crawlers) ? p.crawlers : [];
const engines: any[] = Array.isArray(p.engines) ? p.engines : [];
const sitemap: any = p.sitemap || {};
const fix: any = p.firstFix || null;
/* SEO basics arrived in engine 0.29.0: older checks have no such field, so the block is skipped. */
const seo: { score: number | null; checks: any[] } | null = p.seo && typeof p.seo.score === 'number' ? p.seo : null;

const when = new Date(stored.created_at)
  .toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
const badgeUrl = `${SITE.url}/badge/${stored.id}/`;
const cardUrl = `${SITE.url}/card/${stored.id}/`;
const pageUrl = `${SITE.url}/result/${stored.id}/`;
const badgeBox = badgeSize(current ? current.score : stored.score, BADGE_LABEL);
const score = stored.score;
const grade = String(p.grade || (score >= 80 ? 'A' : score >= 65 ? 'B' : score >= 45 ? 'C' : score >= 25 ? 'D' : 'E'));

/* English needs one form, not three: plural(n, 'thing') gives "thing" or "things". */
const plural = (n: number, one: string) => (n === 1 ? one : `${one}s`);

/*
 * Платная часть проверки (задание 26.09.2026, п. 2 и 3): ответы ChatGPT на три вопроса покупателя и
 * готовый абзац для страницы. Считаются после показа страницы, сохраняются к этой проверке и
 * показываются отсюда же; скрипт ниже только запускает прогон и подменяет два блока готовыми.
 */
const extras = await getExtras(id);
const xs: string = extras?.status || 'none';
const xp: any = extras?.payload || {};
const named: any = xs === 'done' ? xp.named : null;
const ready: any = xs === 'done' ? xp.ready : null;
const readyPage = pickPage(sample);
const envOf = (k: string) => String((import.meta.env as any)[k] || process.env[k] || '').trim();
// Тестовый ключ Cloudflare «всегда проходит, невидимый» только вне Vercel, для локальной проверки.
const tsKey = envOf('PUBLIC_TURNSTILE_SITE_KEY') || (process.env.VERCEL ? '' : '1x00000000000000000000BB');
const namedState = xs === 'done' ? 'done' : xs === 'needs' ? 'needs' : xs === 'error' ? 'error' : 'pending';
const askedOn = xp.at ? new Date(xp.at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : when;
// Город не повторяется, если он уже в нише: «Phuket property shortlist», а не «…, Phuket».
const nichePlace = xp.profile ? (xp.profile.city || xp.profile.country || '') : '';
const niche = xp.profile ? [xp.profile.category, nichePlace && !String(xp.profile.category || '').toLowerCase().includes(nichePlace.toLowerCase()) ? nichePlace : ''].filter(Boolean).join(', ') : '';
/* One colour rule for the whole page: the same thresholds the grade letter uses. */
const tone = (n: number | null) => (n === null ? 'none' : n >= 80 ? 'good' : n >= 45 ? 'fair' : 'poor');
const pct = (s: number | null, m: number) => (s === null || !m ? 0 : Math.round((s / m) * 100));

const blocked = crawlers.filter((c) => c.verdict === 'blocked').length;
const searchBlocked = crawlers.filter((c) => c.kind === 'search' && c.verdict === 'blocked').length;
const problems = areas.reduce((n, a) => n + (a.problems || 0), 0);
const passes = areas.reduce((n, a) => n + (a.findings || []).filter((f: any) => f.level === 'pass').length, 0);
const verdict = score >= 80 ? 'AI systems can read and quote this site.'
  : score >= 65 ? 'Readable, with gaps that cost citations.'
  : score >= 45 ? 'Readable, but there is little to quote.'
  : 'Mostly invisible to answer engines.';
/* The gap is shown only when it is real: fifteen points or more. */
const gap = seo && seo.score !== null && seo.score - score >= 15 ? seo.score - score : 0;
/*
 * What the letter carries, since 16 Sep 2026: the SECOND fix in full and the names of every other
 * finding. The first one is already on this page, so asking for an email in exchange for it is
 * asking for payment for something already given. That is why the button and the form heading talk
 * about the full list, not "the first fix". How to fix each of the rest stays in the paid list:
 * that line must not move.
 */
/*
 * Платный товар в липкой полосе. Цену и адрес оплаты берём из витрины, а не переписываем сюда:
 * цена меняется в одном месте, и полоса не может разойтись со страницей товара.
 *
 * Полосы нет вовсе, когда чинить нечего: продавать список правок тому, у кого правок не нашлось,
 * значит взять деньги за пустой файл.
 */
const SITE_REPORT = PRODUCTS.find((x) => x.slug === 'site-report');
const restN = rest.length;
const total = restN + (fix ? 1 : 0);
const mailCta = !fix ? null : 'Email me the report';
const path = (u: string) => { try { return new URL(u).pathname; } catch { return u; } };
---

<CommercialLayout
  title={`${stored.domain} scored ${score}/100 on AI visibility`}
  description={`How ${stored.domain} reads to ChatGPT, Perplexity, Claude, Copilot and Gemini, measured ${when} on public signals only.`}
  canonical={pageUrl}
  ogImage={`${cardUrl}?png=1`}
  noindex={true}
  theme="light"
>
  <div class="doc">
    <article class={`report t-${tone(score)}`}>

      <header class="card hero">
        {/*
          Кольцо, а не буква. Буква «A» сама по себе ничего не объясняла: владелец спросил прямо,
          что это такое. Кольцо показывает и число, и какую часть круга оно занимает, то есть
          объясняет себя без подписи. Буква осталась в строке ниже, где рядом сказано, к чему она.
        */}
        <svg class={`ring r-${tone(score)}`} viewBox="0 0 148 148" width="148" height="148" role="img" aria-label=`${score} of 100, grade ${grade}`>
          <circle cx="74" cy="74" r="58" fill="none" stroke="#ECE9E2" stroke-width="12" />
          <circle cx="74" cy="74" r="58" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round"
                  stroke-dasharray="364.4" stroke-dashoffset={(364.4 * (1 - score / 100)).toFixed(1)} transform="rotate(-90 74 74)" />
          <text class="ring-num" x="74" y="80" text-anchor="middle">{score}</text>
          <text class="ring-of" x="74" y="101" text-anchor="middle">OF 100</text>
        </svg>
        <div class="hero-body">
          <p class="eyebrow">AI visibility check · {when}{p.ms ? ` · ${(p.ms / 1000).toFixed(1)} s` : ''}</p>
          <h1>{stored.domain}</h1>
          <p class="twin">
            <span class={`twin-item p-${tone(score)}`}><span class="twin-k">AI visibility</span> <b class={`twin-g g-${tone(score)}`}>{grade}</b> <span class="twin-n">{score}/100</span></span>
            {seo && seo.score !== null && (
              <span class={`twin-item p-${tone(seo.score)}`}><span class="twin-k">SEO basics</span> <b class={`twin-g g-${tone(seo.score)}`}>{seo.score >= 80 ? 'A' : seo.score >= 65 ? 'B' : seo.score >= 45 ? 'C' : 'D'}</b> <span class="twin-n">{seo.score}/100</span></span>
            )}
          </p>
          {gap > 0 && (
            <p class="gap">
              <b>A gap: for AI systems this site is {gap} {plural(gap, 'point')} worse than it is for ordinary search.</b>
              Titles, descriptions and addresses are in order, but what ChatGPT, Perplexity and Gemini need before they quote a site is missing. That is where people now look.
            </p>
          )}
          <p class="verdict">{verdict} {passes} {plural(passes, 'check')} passed, {problems} {plural(problems, 'thing')} to fix.</p>
          {/*
            Two actions in the header, both about the report itself: get the fixes, and pass it on.
            A download-the-picture button used to sit here with no context, and the owner rightly
            asked what picture, where to and what for: 1200 by 630 is a link preview, not a story.
            The picture now does its job silently in that preview. "Share" opens the system sheet
            on a phone and copies the link on a desktop.
          */}
          <div class="btn-row">
            <a class="btn btn-main" href="/pricing/">Watch this weekly, 7 days free</a>
            <button type="button" class="btn btn-quiet" id="share" data-url={pageUrl} data-title={`${stored.domain} scored ${score}/100 on AI visibility`}>Share</button>
          </div>
          {moved && (
            <p class="moved">This is the run from {when}, when it scored {score}. <a href={`/result/${moved.id}/`}>Checked again since: now {moved.score}</a>.</p>
          )}
        </div>
      </header>

      {tsKey && (
        <section class="card named" id="x-named" data-state={namedState} data-id={stored.id} data-sitekey={tsKey} aria-live="polite">
          <div class="card-head"><h2>Who ChatGPT names instead of you</h2><span class="card-meta">3 buyer questions</span></div>
          {namedState === 'done' && named ? (
            <>
              <p class="nm-big">ChatGPT named {stored.domain} in <b>{named.named} of {named.asked}</b> answers.</p>
              {niche && <p class="lede">We asked it the way a buyer looking for <b>{niche}</b> would.</p>}
              <ul class="nm-rows">
                {named.rows.map((r: any) => (
                  <li>
                    <p class="nm-q">"{r.question}"</p>
                    <p class="nm-a">
                      {r.error ? <span class="chip chip-none">not answered</span> : r.named ? <span class="chip chip-good">named you</span> : <span class="chip chip-poor">not named</span>}
                      {r.comp.length > 0 && <span class="nm-names">{r.named ? 'Also named' : 'Named instead'}: {r.comp.join(', ')}</span>}
                    </p>
                    {r.other.length > 0 && <p class="nm-meta">Not counted as competitors: {r.other.join(', ')}</p>}
                    {r.unclear.length > 0 && <p class="nm-meta">Could not identify: {r.unclear.join(', ')}</p>}
                  </li>
                ))}
              </ul>
              <p class="nm-cta">Watch asks ten questions like these every week and shows what changes. 7 days free.</p>
              <a class="btn btn-main" href="/pricing/">Start 7 days free</a>
              <p class="note">Answers come from ChatGPT through its API with web search switched on, asked on {askedOn}. They change from run to run, so treat one run as a sample, not a verdict.</p>
            </>
          ) : namedState === 'needs' ? (
            <form class="nm-sell" id="nm-sell">
              <label for="sell">We could not tell from the site what you sell. What do you sell, and where?</label>
              <div class="nm-row"><input id="sell" name="sell" required maxlength="120" placeholder="dentist, Bristol" autocomplete="off" /><button type="submit" class="btn btn-main">Ask ChatGPT</button></div>
            </form>
          ) : namedState === 'error' ? (
            <p class="lede">ChatGPT did not answer this time. <button type="button" class="btn btn-quiet" id="nm-retry">Ask again</button></p>
          ) : (
            <p class="lede nm-wait"><span class="spin" aria-hidden="true"></span>Asking ChatGPT three questions a buyer would ask about a business like {stored.domain}. This takes under a minute.</p>
          )}
          <template id="nm-limit"><p class="lede">You have used your {FREE_RUNS_PER_IP} free checks today. Watch runs them every week: 7 days free.</p><a class="btn btn-main" href="/pricing/">Start 7 days free</a></template>
          <template id="nm-blocked"><p class="lede">We could not confirm this is a person and not a script, so ChatGPT was not asked. Reload the page to try again.</p></template>
          <div id="nm-ts" class="nm-ts"></div>
        </section>
      )}

      {searchBlocked > 0 && (
        <p class="alarm">{searchBlocked} of the crawlers that fetch pages in order to cite them {searchBlocked === 1 ? 'is' : 'are'} turned away in robots.txt. Those are the bots that put a site into an answer.</p>
      )}

      {engines.length > 0 && (
        <section class="card">
          <div class="card-head"><h2>Readiness by engine</h2><span class="card-meta">{engines.length} engines</span></div>
          <p class="lede">The formula is the one behind the overall score. Engines differ in one real thing only: what robots.txt answers their own crawlers. So on a site that blocks nobody the numbers match, and that is the right answer.</p>
          <div class="eng-grid">
            {engines.map((e: any) => (
              <div class={`eng e-${tone(e.score)}`}>
                <p class="eng-name">{e.label}</p>
                <p class="eng-num">{e.score === null ? '—' : e.score}</p>
                <div class="bar"><i style={`width:${e.score || 0}%`}></i></div>
                <p class="eng-how">{e.how}</p>
                {e.blocked.length > 0 && <p class="eng-bad">Blocked: {e.blocked.join(', ')}</p>}
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="card">
        <div class="card-head"><h2>What the score is made of</h2><span class="card-meta">5 areas</span></div>
        <div class="areas">
          {areas.map((a: any) => (
            <div class={`area a-${tone(a.score === null ? null : pct(a.score, a.max))}`}>
              <div class="area-head">
                <span class="area-name">{a.label}</span>
                <span class="area-w">worth {a.max}</span>
                <span class="area-n">{a.score === null ? '—' : a.score}<span class="of">/{a.max}</span></span>
              </div>
              <div class="bar"><i style={`width:${pct(a.score, a.max)}%`}></i></div>
              <ul class="fl">
                {(a.findings || []).filter((f: any) => f.level === 'pass').map((f: any) => (
                  <li class="f-pass"><span class="chip">pass</span><span>{f.text}</span></li>
                ))}
                {a.problems > 0 && (
                  <li class="f-more"><span class="chip chip-fair">to fix</span><span>{a.problems} {plural(a.problems, 'thing')} in this area, listed below</span></li>
                )}
              </ul>
            </div>
          ))}
        </div>
      </section>

      {seo && seo.score !== null && (
        <section class="card">
          <div class="card-head"><h2>SEO basics on the same pages</h2><span class="card-meta">{seo.score}/100</span></div>
          <p class="lede">Worked out from what was already read, with no extra requests. These are the basics, not a full audit: speed, links and rankings are not here.</p>
          <ul class="seo">
            {seo.checks.map((c: any) => (
              <li class={`s-${tone(c.total ? Math.round((c.passed / c.total) * 100) : null)}`}><span class="seo-n">{c.passed}/{c.total}</span><span>{c.label}</span></li>
            ))}
          </ul>
        </section>
      )}

      {fix && (
        <section class="card fix">
          <div class="card-head"><h2>The first fix, written out</h2><span class="card-meta">{fix.area}</span></div>
          <dl class="fix-parts">
            <dt>{fix.labels?.now || 'Now'}</dt><dd>{fix.now}</dd>
            <dt>{fix.labels?.task || 'Task'}</dt><dd>{fix.task}</dd>
            <dt>{fix.labels?.verify || 'How to check'}</dt><dd>{fix.verify}</dd>
          </dl>
          <p class="note">Hand this to whoever runs the site. It is written so it can be done without asking us anything.</p>
        </section>
      )}

      {tsKey && (ready || (namedState !== 'done' && readyPage)) && (
        <section class="card ready" id="x-ready">
          <div class="card-head"><h2>Ready to paste</h2><span class="card-meta">{(ready ? ready.page : readyPage?.path) === '/' ? 'your homepage' : (ready ? ready.page : readyPage?.path)}</span></div>
          {ready ? (
            <>
              <p class="lede"><b>{ready.a}</b></p>
              <div class="rt-box" id="ready-text">{ready.x}</div>
              {(ready.n || []).map((t: string) => <p class="note">{t}</p>)}
              <button type="button" class="rt-copy" data-copy-from="ready-text">Copy the text</button>
              <p class="rt-cta">Watch writes one of these every week, for the questions your buyers ask ChatGPT.</p>
              <a class="btn btn-main" href="/pricing/">Watch this weekly, 7 days free</a>
            </>
          ) : (
            <p class="lede nm-wait"><span class="spin" aria-hidden="true"></span>Writing an opening paragraph for {readyPage?.path === '/' ? 'your homepage' : readyPage?.path} from what your own pages say.</p>
          )}
        </section>
      )}

      {rest.length > 0 && (
        <section class="card locked">
          <div class="card-head"><h2>{rest.length === 1 ? 'One more finding' : `${rest.length} more findings`}</h2><span class="card-meta">written out in Watch</span></div>
          <ul class="fl">
            {rest.map((x: any) => (
              <li class={`r-${x.level}`}>
                <span class={`chip ${x.level === 'warn' ? 'chip-fair' : 'chip-poor'}`}>{x.level === 'warn' ? 'partial' : 'problem'}</span>
                <span class="r-area">{x.area}:</span>
                <span class="smudge">{x.teaser}</span>
              </li>
            ))}
          </ul>
          <p class="note">The list is real and this is its length. Watch writes out every line the same way as the fix above, with the text to paste, and checks every week whether ChatGPT names you.</p>
          <a class="btn btn-main" href="/pricing/">Watch this weekly, 7 days free</a>
          <p class="note">Or the <a href="/products/seo-audit/">full one-off audit, $149</a>.</p>
        </section>
      )}

      {fix && (
        <section class="card capture" id="capture">
          <div class="card-head"><h2>{restN ? `${restN} more ${plural(restN, 'finding')} on ${stored.domain} we did not show` : 'The fix above, by email'}</h2></div>
          <p class="lede">{restN
            ? 'We will email the second fix written out in full, like the first one, and the names of every other finding, so you see the whole picture. Keep it, or hand it to whoever runs the site. It arrives in a few minutes.'
            : `We will email the fix above, written out in full for ${stored.domain}. One letter, so you can hand it to whoever runs the site.`}</p>
          <form id="pdf-form" novalidate data-url={p.url || `https://${stored.domain}/`}>
            <div class="row">
              <label class="sr" for="pdf-email">Email</label>
              <input id="pdf-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
              <button type="submit" class="btn btn-main" id="pdf-btn">{'Email me the report'}</button>
            </div>
            <label class="consent"><input type="checkbox" id="pdf-consent" name="consent" required /> I agree to receive the report and follow-up emails about it. One click unsubscribes.</label>
            <div class="hp" aria-hidden="true"><label for="website">Website</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
            <p class="msg" id="pdf-msg" hidden></p>
          </form>
        </section>
      )}

      {sample.length > 0 && (
        <section class="card">
          <div class="card-head"><h2>The pages we read</h2><span class="card-meta">{sample.length}{sitemap.found ? ` of ${sitemap.count} in the sitemap` : ''}</span></div>
          <div class="scroll">
            <table>
              <thead><tr><th>Page</th><th>Words</th><th>H2</th><th>Tables</th><th>Links</th><th>Images</th><th>Answer first</th><th>Dated</th><th>Schema</th></tr></thead>
              <tbody>
                {sample.map((s: any) => (
                  <tr>
                    <td class="cell-url"><a href={s.url} rel="nofollow noopener" target="_blank">{path(s.url)}</a></td>
                    <td class="n">{s.words}</td>
                    <td class="n">{s.h2 ?? '—'}</td>
                    <td class="n">{s.tables ?? '—'}</td>
                    <td class="n">{s.links ?? '—'}</td>
                    <td class="n">{s.images ?? '—'}</td>
                    <td class={s.answerFirst ? 'ok' : 'bad'}>{s.answerFirst ? 'yes' : 'no'}</td>
                    <td class={s.dated ? 'ok' : 'bad'}>{s.dated ? 'yes' : 'no'}</td>
                    <td>{(s.schema || []).join(', ') || 'none'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="note">Other checks read one page. This one read {sample.length}.</p>
        </section>
      )}

      {crawlers.length > 0 && (
        <section class="card">
          <div class="card-head"><h2>The crawlers we asked about</h2><span class="card-meta">{crawlers.length}{blocked ? `, ${blocked} blocked` : ', none blocked'}</span></div>
          <div class="scroll">
            <table>
              <thead><tr><th>Crawler</th><th>What it does</th><th>robots.txt</th></tr></thead>
              <tbody>
                {crawlers.map((c: any) => (
                  <tr>
                    <td>{c.label}</td>
                    <td class="muted-cell">{c.kind === 'search' ? 'fetches pages to cite them' : 'collects text for training'}</td>
                    <td class={c.verdict === 'blocked' ? 'bad' : 'ok'}>{c.verdict === 'blocked' ? 'turned away' : 'let in'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <section class="card">
        <div class="card-head"><h2>Put the score on your site</h2></div>
        <p class="lede">It updates itself: check the site again and it shows the new number, with nothing to change on your page.</p>
        <div class="badge-stage">
          <img src={`/badge/${stored.id}/`} alt={`AI visibility score for ${stored.domain}`} width={badgeBox.width} height={badgeBox.height} />
        </div>
        <div class="btn-row">
          <button type="button" class="btn btn-main" data-copy={`<a href="${pageUrl}"><img src="${badgeUrl}" alt="AI visibility score for ${stored.domain}" /></a>`}>Copy the code</button>
          <button type="button" class="btn btn-quiet" data-copy={badgeUrl}>Copy the image address</button>
        </div>
        <details class="code">
          <summary>Show the code</summary>
          <label for="embed-html">HTML</label>
          <textarea id="embed-html" readonly rows="3">{`<a href="${pageUrl}"><img src="${badgeUrl}" alt="AI visibility score for ${stored.domain}" /></a>`}</textarea>
