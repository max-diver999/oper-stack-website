<script>
  /* Последний проверенный сайт: форма после оплаты подписки подставит его сама (задание 25.09.2026, 3.1). */
  try { const d = document.getElementById('share')?.getAttribute('data-title')?.split(' scored ')[0]; if (d) localStorage.setItem('os-last-site', d); } catch { /* приватный режим */ }
  const track = (name: string, params: Record<string, unknown>) => { const w = window as any; if (typeof w.operStackTrack === 'function') w.operStackTrack(name, params); };
  function origin(): { from: string; campaign: string } {
    const KEY = 'os-origin';
    try {
      const q = new URLSearchParams(location.search);
      const from = q.get('utm_source') || q.get('ref') || '';
      const campaign = q.get('utm_campaign') || '';
      if (from) { const v = { from, campaign }; sessionStorage.setItem(KEY, JSON.stringify(v)); return v; }
      const saved = sessionStorage.getItem(KEY);
      if (saved) return JSON.parse(saved);
    } catch { /* private window: the server works the source out from Referer */ }
    return { from: '', campaign: '' };
  }
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

  /* Share: the system sheet on a phone, a copied link on a desktop. */
  const share = document.getElementById('share') as HTMLButtonElement | null;
  share?.addEventListener('click', async () => {
    const url = share.dataset.url || location.href;
    const nav = navigator as any;
    if (typeof nav.share === 'function') {
      try { await nav.share({ title: share.dataset.title || document.title, url }); return; } catch { /* cancelled: say nothing */ }
    }
    try { await navigator.clipboard.writeText(url); } catch { return; }
    const was = share.textContent; share.textContent = 'Link copied';
    setTimeout(() => { share.textContent = was; }, 1800);
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); } catch { return; }
      const was = b.textContent;
      b.textContent = 'Copied';
      setTimeout(() => { b.textContent = was; }, 1600);
    });
  });

  /*
   * The email exchange lives here, not on the form page: the result now opens at its own address
   * and that is where it is read. The confirmation replaces the form entirely: no form, no second
   * letter, and the address is named out loud so nobody wonders whether it went.
   */
  const pdfForm = document.getElementById('pdf-form') as HTMLFormElement | null;
  const pdfMsg = document.getElementById('pdf-msg') as HTMLElement | null;
  const pdfBtn = document.getElementById('pdf-btn') as HTMLButtonElement | null;
  const siteUrl = (document.querySelector('.cell-url a') as HTMLAnchorElement | null)?.href || `https://${location.pathname.split('/')[2] || ''}`;
  pdfForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!pdfMsg || !pdfBtn) return;
    pdfMsg.hidden = true; pdfBtn.disabled = true;
    const fd = new FormData(pdfForm);
    try {
      const res = await fetch('/api/visibility-task/', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: fd.get('email'), url: pdfForm.dataset.url || siteUrl, website: fd.get('website'), ...origin() }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Could not send it');
      track('lead_form_submit', { form_name: 'ai_visibility_task' });
      const sentTo = String(fd.get('email') || '').trim();
      const box = document.getElementById('capture') as HTMLElement;
      box.classList.add('sent');
      box.setAttribute('role', 'status');
      box.innerHTML = `<p class="sent-tick" aria-hidden="true">✓</p><h2>The letter is on its way to ${esc(sentTo)}</h2><p class="lede">It arrives within a couple of minutes from <b>info@oper-stack.com</b>. If you do not see it, look in spam and mark it "not spam", and the next ones will land straight away.</p>`;
      const bar = document.getElementById('bar'); if (bar) bar.hidden = true;
    } catch (err: any) {
      pdfMsg.hidden = false; pdfMsg.textContent = err.message || 'Could not send it';
      pdfBtn.disabled = false;
    }
  });

  /* Sticky bar: it appears once the header has scrolled away, and hides when its own button is on screen anyway. */
  const bar = document.getElementById('bar') as HTMLElement | null;
  const hero = document.querySelector('.hero') as HTMLElement | null;
  /*
   * Полоса несёт платный товар, поэтому прячется она от ДРУГОЙ кнопки того же товара в теле
   * страницы, а не от формы почты: две одинаковые кнопки на одном экране это шум.
   */
  const buyInPage = document.querySelector('.locked .btn-main') as HTMLElement | null;
  function syncBar() {
    if (!bar || !hero) return;
    const h = hero.getBoundingClientRect();
    const b = buyInPage ? buyInPage.getBoundingClientRect() : null;
    const buyOnScreen = !!b && b.top < window.innerHeight && b.bottom > 0;
    bar.hidden = !(h.bottom < 0 && !buyOnScreen);
  }
  window.addEventListener('scroll', syncBar, { passive: true });
  window.addEventListener('resize', syncBar);
  syncBar();
</script>

<script>
  /*
   * Платная часть проверки. Невидимый Turnstile даёт токен, POST /api/check-extras/ запускает прогон
   * (или отдаёт сохранённое), затем два блока подменяются теми, что сервер нарисовал заново: один
   * способ рисовать, на сервере. Лимит и Turnstile показываются здесь, их сервер не хранит.
   */
  const named = document.getElementById('x-named') as HTMLElement | null;
  const checkId = named?.dataset.id || '';
  const siteKey = named?.dataset.sitekey || '';
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  async function swap() {
    const html = await (await fetch(location.href, { cache: 'no-store' })).text();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    for (const id of ['x-named', 'x-ready']) {
      const fresh = doc.getElementById(id); const old = document.getElementById(id);
      if (old && fresh) old.replaceWith(fresh); else if (old && !fresh) old.remove();
    }
    bind();
  }
  function showTemplate(name: string) {
    const box = document.getElementById('x-named'); const t = document.getElementById(name) as HTMLTemplateElement | null;
    if (!box || !t) return;
    const head = box.querySelector('.card-head');
    [...box.children].forEach((c) => { if (c !== head && c.tagName !== 'TEMPLATE' && c.id !== 'nm-ts') c.remove(); });
    box.insertBefore(t.content.cloneNode(true), document.getElementById('nm-ts'));
    document.getElementById('x-ready')?.remove();
  }
  function loadTurnstile(): Promise<any> {
    const w = window as any;
    if (w.turnstile) return Promise.resolve(w.turnstile);
    return new Promise((resolve, reject) => {
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
      s.async = true; s.onload = () => resolve(w.turnstile); s.onerror = reject;
      document.head.appendChild(s);
    });
  }
  async function token(): Promise<string> {
    const ts = await loadTurnstile();
    return new Promise((resolve) => {
      const holder = document.getElementById('nm-ts'); if (!holder) return resolve('');
      holder.innerHTML = '';
      ts.render(holder, { sitekey: siteKey, callback: (t: string) => resolve(t), 'error-callback': () => { resolve(''); return true; }, 'expired-callback': () => resolve('') });
    });
  }
  async function run(sell = '') {
    let t = '';
    try { t = await token(); } catch { t = ''; }
    const res = await fetch('/api/check-extras/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: checkId, token: t, sell }) });
    const data = await res.json().catch(() => ({ status: 'error' }));
    if (data.status === 'running') { for (let k = 0; k < 45; k += 1) { await sleep(4000); const d = await (await fetch(`/api/check-extras/?id=${encodeURIComponent(checkId)}`, { cache: 'no-store' })).json().catch(() => ({})); if (d.status && d.status !== 'running') break; } return swap(); }
    if (data.status === 'limit') return showTemplate('nm-limit');
    if (data.status === 'blocked') return showTemplate('nm-blocked');
    return swap();
  }
  function bind() {
    const box = document.getElementById('x-named') as HTMLElement | null;
    if (!box) return;
    const state = box.dataset.state;
    if (state === 'pending' && !box.dataset.started) { box.dataset.started = '1'; run(); }
    document.getElementById('nm-retry')?.addEventListener('click', () => { run(); });
    const form = document.getElementById('nm-sell') as HTMLFormElement | null;
    form?.addEventListener('submit', (e) => { e.preventDefault(); const v = String(new FormData(form).get('sell') || '').trim(); if (!v) return; form.querySelector('button')?.setAttribute('disabled', ''); run(v); });
  }
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest('[data-copy-from]') as HTMLButtonElement | null;
    if (!b) return;
    const box = document.getElementById(b.dataset.copyFrom || '');
    try { await navigator.clipboard.writeText(box?.textContent || ''); b.textContent = 'Copied'; }
    catch { const r = document.createRange(); if (box) { r.selectNodeContents(box); const s = getSelection(); s?.removeAllRanges(); s?.addRange(r); } b.textContent = 'Selected: press Cmd+C'; }
    setTimeout(() => { b.textContent = 'Copy the text'; }, 2500);
  });
  if (checkId && siteKey) bind();
</script>

