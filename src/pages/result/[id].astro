---
/**
 * Постоянный адрес одной проверки.
 *
 * Простым языком. Раньше результат жил во вкладке и умирал вместе с ней. Теперь у него есть адрес:
 * его кладут в закладки, пересылают разработчику и открывают через неделю, чтобы сравнить. Здесь
 * же владелец берёт код значка для своего сайта.
 *
 * Страница закрыта от индексации намеренно: это чужие сайты и их баллы, им незачем всплывать в
 * поиске по чужому имени. Лента последних проверок на /checks/ показывает только домен и балл,
 * и только по одному, самому свежему результату на домен.
 */
import CommercialLayout from '../../components/CommercialLayout.astro';
import { loadCheck, latestForDomain } from '../../lib/check-store';
import { SITE } from '../../data/site';

export const prerender = false;

const id = String(Astro.params.id || '');
const stored = await loadCheck(id);
if (!stored) return Astro.redirect('/ai-visibility/', 302);

const current = await latestForDomain(stored.domain);
/*
 * Показываем «проверяли снова» только если балл ПОМЕНЯЛСЯ: иначе человек читает «последний прогон
 * дал 89» на странице, где и так 89.
 */
const moved = current && current.id !== stored.id && current.score !== stored.score ? current : null;
const p: any = stored.payload || {};
const when = new Date(stored.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
/*
 * Адрес значка со слешем на конце, а не с .svg. У сайта включено trailingSlash: 'always', при
 * котором адрес с расширением не находится вовсе: 17.09.2026 значок так и отдавал 404 на боевом.
 * Правило перезаписи в настройке Vercel не сработало, а гадать дальше дороже, чем взять рабочее.
 * Картинке расширение не нужно: браузер смотрит на content-type, а мы отдаём image/svg+xml.
 */
const badgeUrl = `${SITE.url}/badge/${stored.id}/`;
const pageUrl = `${SITE.url}/result/${stored.id}/`;
const grade = stored.score >= 80 ? 'A' : stored.score >= 65 ? 'B' : stored.score >= 45 ? 'C' : 'D';
---

<CommercialLayout
  title={`${stored.domain} scored ${stored.score}/100 on AI visibility`}
  description={`How ${stored.domain} reads to ChatGPT, Perplexity, Claude, Copilot and Gemini, measured ${when} on public signals only.`}
  canonical={pageUrl}
  noindex={true}
>
  <div class="wrap">
    <p class="eyebrow">AI visibility check · {when}</p>
    <h1>{stored.domain} scored {stored.score} of 100</h1>
    <p class="grade">Grade {grade}</p>

    {moved && (
      <p class="moved">
        This is the run from {when}, when it scored {stored.score}. Checked again since:
        <a href={`/result/${moved.id}/`}>now {moved.score}</a>.
      </p>
    )}

    {p.headline && <p class="lede">{p.headline}</p>}

    <section class="embed">
      <h2>Put the score on your site</h2>
      <p class="embed-lede">The image updates itself: check the site again and it shows the new number, with nothing to change on your page.</p>

      <div class="badge-stage">
        <img src={`/badge/${stored.id}/`} alt={`AI visibility score for ${stored.domain}`} width="180" height="28" />
      </div>

      <div class="copy-row">
        <button type="button" class="btn btn-main" data-copy={`<a href="${pageUrl}"><img src="${badgeUrl}" alt="AI visibility score for ${stored.domain}" /></a>`}>Copy the code for your site</button>
        <button type="button" class="btn" data-copy={badgeUrl}>Copy the image address</button>
      </div>

      <details class="code">
        <summary>Show the full code</summary>
        <label for="embed-html">HTML</label>
        <textarea id="embed-html" readonly rows="3">{`<a href="${pageUrl}"><img src="${badgeUrl}" alt="AI visibility score for ${stored.domain}" /></a>`}</textarea>
        <label for="embed-md">Markdown</label>
        <textarea id="embed-md" readonly rows="3">{`[![AI visibility score](${badgeUrl})](${pageUrl})`}</textarea>
      </details>
    </section>

    <section class="share">
      <h2>Share it</h2>
      <p class="share-row">
        <button type="button" class="btn" data-copy={pageUrl}>Copy the link</button>
        <a class="btn" rel="noopener" target="_blank"
           href={`https://x.com/intent/tweet?text=${encodeURIComponent(`${stored.domain} scores ${stored.score}/100 on AI visibility`)}&url=${encodeURIComponent(pageUrl)}`}>Share on X</a>
      </p>
      <p class="share-more"><a href="/ai-visibility/">Check another site</a></p>
    </section>

    <p class="note">
      Public signals only, measured {when}. This page is not indexed: it holds someone else's site and someone else's score.
    </p>
  </div>
</CommercialLayout>

<script>
  // Кнопки «скопировать»: человеку нужен код в буфере, а не выделять его мышкой в поле.
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); } catch { return; }
      const was = b.textContent;
      b.textContent = 'Copied';
      setTimeout(() => { b.textContent = was; }, 1600);
    });
  });
</script>

<style>
  .wrap { max-width: 780px; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
  .eyebrow { font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.6; margin: 0 0 0.5rem; }
  h1 { margin: 0 0 0.3rem; line-height: 1.15; }
  .grade { margin: 0 0 1.25rem; font-weight: 600; opacity: 0.8; }
  .lede { font-size: 1.05rem; line-height: 1.55; }
  .moved { padding: 0.75rem 1rem; border-radius: 10px; background: color-mix(in srgb, currentColor 7%, transparent); }
  section { margin-top: 2.5rem; }
  h2 { font-size: 1.15rem; margin: 0 0 0.5rem; }
  label { display: block; margin: 0.9rem 0 0.25rem; font-size: 0.8rem; opacity: 0.7; }
  textarea { width: 100%; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8rem; padding: 0.6rem; border-radius: 8px; border: 1px solid var(--color-border, rgba(255,255,255,0.15)); background: transparent; color: inherit; resize: vertical; }
  .embed-lede { margin: 0 0 1.25rem; }
  .badge-stage { display: flex; align-items: center; justify-content: center; padding: 2rem 1rem; border-radius: 12px; background: color-mix(in srgb, currentColor 5%, transparent); border: 1px solid var(--color-border, rgba(255,255,255,0.1)); }
  .badge-stage img { width: 180px; height: 28px; }
  .copy-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 1rem; }
  .btn-main { border-color: currentColor; font-weight: 600; }
  .code { margin-top: 1.25rem; }
  .code summary { cursor: pointer; font-size: 0.875rem; opacity: 0.75; }
  .share-row { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .share-more { margin-top: 0.9rem; font-size: 0.9rem; }
  .btn { display: inline-block; cursor: pointer; background: transparent; color: inherit; font: inherit; padding: 0.55rem 1rem; border-radius: 8px; border: 1px solid var(--color-border, rgba(255,255,255,0.2)); text-decoration: none; margin-right: 0.5rem; }
  .note { margin-top: 2.5rem; font-size: 0.85rem; opacity: 0.65; }
</style>
