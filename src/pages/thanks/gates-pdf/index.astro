---
import { SITE } from '../../../data/site';
import Favicon from '../../../components/Favicon.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Your copy of Sixteen Gates · {SITE.name}</title>
  <Favicon />
  <link rel="preload" href="/fonts/dm-sans-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fraunces.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <style>
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0B1017; color: #F5F2EC; font-family: 'DM Sans', system-ui, sans-serif; padding: 24px; text-align: center; }
    h1 { font-family: 'Fraunces', Georgia, serif; font-size: 32px; margin-bottom: 12px; }
    p { color: #8B939E; max-width: 460px; margin: 0 auto 20px; line-height: 1.5; }
    a { color: #3DB8A9; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 20px; border-radius: 10px; background: linear-gradient(135deg, #1A8A7D, #156b62); color: #fff; text-decoration: none; font-weight: 600; }
    code { font-family: 'JetBrains Mono', ui-monospace, monospace; color: #E8B84A; background: rgba(0,0,0,.35); padding: 6px 10px; border-radius: 8px; }
  </style>
</head>
<body>
  <div>
    <h1>Here is your copy</h1>
    <p>Sixteen gates, eight pages: each gate, the failure it was written for, and the fix.</p>
    <p><a class="btn" href="/downloads/operstack-sixteen-gates.pdf" download>Download the PDF</a></p>
    <p>Run the gates on your own site in one command:<br /><code>npx @operstack/gates</code></p>
    <p><a href="/ai-visibility/">Check another site</a> · <a href="/products/">All products</a></p>
  </div>
</body>
</html>
