---
import CommercialLayout from '../components/CommercialLayout.astro';
import { SITE } from '../data/site';
import { NETWORK_HERO } from '../data/cases';
import ownScore from '../data/own-score.json';
/* Разбивка «сколько замеров за запуск» считается при сборке настоящим прогоном, см. scripts/measure-own-score.mjs. */
const counts = (ownScore as { counts?: { pages: number; seoRules: number; seo: number; contentFields: number; content: number; robots: number; site: number; engines: number; total: number; robotNames: string[] } }).counts ?? null;

/*
 * Переупаковка 25.09.2026 (план Максима «OperStack: переупаковка», версия 2). Одно обещание,
 * одна подписка, один главный призыв на экране. Бесплатная проверка остаётся прежней: балл,
 * пять областей, первая правка. Вопросы к ChatGPT задаются только подписчикам, в бесплатной
 * проверке их нет. Сравнений с похожими сервисами на сайте нет, только с дорогими
 * инструментами и агентствами. Число +279% стоит по решению Максима, подписано как наши кейсы
 * с источником. Пример ответа ChatGPT настоящий: прогон 25.09.2026, модель через API с поиском.
 */
const score = typeof ownScore?.score === 'number' ? ownScore.score : null;
const areas = Array.isArray(ownScore?.areas) ? ownScore.areas : [];
const measured = ownScore?.measured || '';
const WATCH_PRICE = '35 USD';
const WATCH_SAMPLE = {
  question: 'Best real estate agency in Phuket for international buyers?',
  named: ['Siam Expat Property', 'Twins Real Estate', 'Butler Estates', 'ZODIAC', 'NOVA Estate', 'Phuket Realtor'],
  you: 'MORE Group, our own property business',
  when: '25 September 2026',
};
const askChatGpt = `https://chatgpt.com/?q=${encodeURIComponent('What is OperStack (oper-stack.com), and is it a good way to check whether ChatGPT recommends my business?')}`;
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  publisher: { '@id': `${SITE.url}/#organization` },
  inLanguage: 'en',
};
const title = 'Get Named by ChatGPT, Not Just Found on Google · OperStack';
const description = 'AI visibility software. A free check of what ChatGPT, Claude, Perplexity and Gemini see on your site, then OperStack Watch: every week, whether ChatGPT names you, who it names instead, and what to fix. 7 days free, then 35 USD a month.';
---

<CommercialLayout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={websiteSchema}>
  <main class="hm">
    <section class="hero">
      <p class="eyebrow">AI visibility software</p>
      <h1>Get named by <em>ChatGPT</em>, not just found on Google</h1>
      <p class="lede">More buyers now ask an assistant instead of a search engine. It reads a few sites and names two or three businesses. Start with a free check of what AI sees on your site and what to fix first.</p>
      <form class="check" action="/ai-visibility/" method="get">
        <label class="sr" for="home-url">Site address</label>
        <input id="home-url" name="url" type="text" inputmode="url" placeholder="your-site.com" autocomplete="url" required />
        <button type="submit">Check my site free</button>
      </form>
      <p class="under">Half a minute · no signup · nothing to install · <b>result on screen</b></p>
      <ul class="edge">
        <li><b>Ten pages, not one.</b> Other tools read a single page and call it a site check.</li>
        <li><b>We name the pages to fix.</b> Not "your content is hard to quote", but a list of addresses.</li>
      </ul>
    </section>

    <section>
      <p class="eyebrow">What Watch shows you every week</p>
      <h2>Who ChatGPT names instead of you</h2>
      <p class="lede">We asked ChatGPT the question a buyer of our own property business would ask. This is the real answer.</p>
      <div class="ask">
        <p class="ask-q"><span>Question</span>{WATCH_SAMPLE.question}</p>
        <p class="ask-l">ChatGPT names</p>
        <ul class="ask-names">{WATCH_SAMPLE.named.map((n) => <li>{n}</li>)}</ul>
        <p class="ask-you"><b>{WATCH_SAMPLE.you}:</b> not named</p>
        <p class="ask-foot">Asked through ChatGPT with web search on {WATCH_SAMPLE.when}, in three wordings; not named in any of them. Answers change from run to run, which is why Watch asks every week and shows the trend.</p>
      </div>
    </section>

    <section>
      <p class="eyebrow">How it works</p>
      <h2>Check free. Watch every week. Fix with the list.</h2>
      <ol class="steps">
        <li><div><b>Check your site, free</b><p>A score out of 100, five areas and the first fix, on screen. No email, no signup.</p></div></li>
        <li><div><b>Watch it every week: 7 days free, then {WATCH_PRICE} a month</b><p>Whether ChatGPT names you for ten questions your buyers ask, who it names instead, three rivals beside you, and what changed since last week. By email, nothing to connect.</p></div></li>
        <li><div><b>Fix with the list</b><p>Every fix across the site, with the page address and the text ready to paste. Hand it to whoever runs the site.</p></div></li>
      </ol>
      <p class="cta-row"><a class="btn-main" href="/pricing/">Start 7 days free</a><a class="btn-ghost" href="/ai-visibility/">Or run the free check first</a></p>
    </section>

    <section>
      <p class="eyebrow">What it costs to find out</p>
      <h2>Three ways to learn whether AI recommends you</h2>
      <div class="vs">
        <div class="vs-card"><span class="tag">An SEO agency</span><p class="vs-price">A monthly retainer</p><p>Reports and calls. You still do not learn whether ChatGPT names you, or who it names instead.</p></div>
        <div class="vs-card"><span class="tag">Semrush</span><p class="vs-price">139 USD a month, 199 with AI search</p><p>A large dashboard of data. What to change on your site is left to you.</p></div>
        <div class="vs-card"><span class="tag">Asking ChatGPT yourself</span><p class="vs-price">Free, once</p><p>One answer, one day. It will not tell you what it said last week, why it picked them, or what to change.</p></div>
        <div class="vs-card us"><span class="tag">OperStack Watch</span><p class="vs-price">{WATCH_PRICE} a month, 7 days free</p><p>Who ChatGPT names instead of you, every week, and the fixes that change it.</p></div>
      </div>
      <p class="src">Semrush prices from semrush.com/prices, monthly billing, checked on 25 September 2026.</p>
    </section>

    <section>
      <p class="eyebrow">Why OperStack</p>
      <h2>Built for the owner, not the SEO team</h2>
      <div class="honest">
        <p><b>Ten pages read, not one.</b> Most checks read your homepage and call it a site.</p>
        <p><b>Nothing to connect.</b> The report is on the site and in your inbox every week. No Claude, no Cursor, no developer.</p>
        <p><b>The pages to fix, and the text to paste.</b> Not "improve your content", but this page, this line, this replacement.</p>
        <p><b>Every score adds up by hand.</b> If we could not measure something, we say so instead of counting it as zero.</p>
        <p><b>Pay once if you prefer.</b> A full audit of your site for 149 USD, no subscription.</p>
      </div>
    </section>

    <section>
      <p class="eyebrow">Our own cases</p>
      <h2>We built this for our own sites first</h2>
      <div class="proof">
        <div class="proof-big">+279%</div>
        <p class="proof-line">organic clicks month over month across {NETWORK_HERO.liveSites} of our own brands in {NETWORK_HERO.marketCount} countries.</p>
        <p class="proof-src">Our own sites, not client promises. Data from Google Search Console. <a href="/cases/">See the cases</a></p>
      </div>
      {score !== null && (
        <div class="sample">
          <div class="sample-top">
            <div class="num">{score}<span>/100</span></div>
            <p>And we measure ourselves with the same tool: this site{measured ? ` on ${measured}` : ''}. The score is the sum of five areas; add them up by hand and you get exactly this number.</p>
          </div>
          <div class="bars">
            {areas.map((a) => (
              <div>
                <p class="bar-label">{a.label}</p>
                <div class="track"><div class={`fill${a.max && a.score / a.max < 0.5 ? ' low' : ''}`} style={`width:${a.max ? Math.round((a.score / a.max) * 100) : 0}%`}></div></div>
                <p class="val">{a.score} of {a.max}</p>
              </div>
            ))}
          </div>
          {counts && <p class="small">One free run covers {counts.pages} pages, {counts.robots} AI crawlers by name and {counts.total} measurements in all.</p>}
        </div>
      )}
      <p class="cta-row"><a class="btn-ghost" href={askChatGpt} target="_blank" rel="noopener">Ask ChatGPT about OperStack</a></p>
    </section>

    <section>
      <p class="eyebrow">Questions</p>
      <h2>Before you start</h2>
      <div class="faq">
        <details><summary>How is this different from Semrush?</summary><p>Semrush gives you keyword and ranking data and leaves the conclusions to you. OperStack answers one question every week: does ChatGPT name you, who does it name instead, and what on your site to change. It costs {WATCH_PRICE} a month instead of 139 or more.</p></details>
        <details><summary>What happens after the 7 days?</summary><p>If you do nothing, the subscription continues at {WATCH_PRICE} a month. Cancel before day 7 and you pay nothing.</p></details>
        <details><summary>How do I cancel?</summary><p>In your Whop account, in one click, at any time. The weekly letters stop at the end of the period you paid for.</p></details>
        <details><summary>What do you do with my data?</summary><p>We read the public pages of your site, the way a search engine does, and keep your email to send the weekly letter. Nothing else. <a href="/privacy/">Privacy</a></p></details>
        <details><summary>Do I need a developer?</summary><p>No. Most fixes are text you paste into your site. The few that need a developer are marked, written so you can forward them.</p></details>
      </div>
    </section>

    <section class="final">
      <h2>Find out what AI sees on your site</h2>
      <p class="lede">The check takes half a minute and costs nothing.</p>
      <form class="check" action="/ai-visibility/" method="get">
        <label class="sr" for="home-url-2">Site address</label>
        <input id="home-url-2" name="url" type="text" inputmode="url" placeholder="your-site.com" autocomplete="url" required />
        <button type="submit">Check my site free</button>
      </form>
      <p class="oneoff">Prefer a one-off? <a href="/products/seo-audit/">Full audit, 149 USD</a></p>
    </section>
  </main>
</CommercialLayout>

<style>
  .hm { max-width: 1000px; margin: 0 auto; padding: 0 20px 40px; }
  .hm section { padding-block: 52px; border-top: 1px solid rgba(255,255,255,.08); }
  .hm section:first-child { border-top: 0; }
  .hm h1, .hm h2, .hm h3 { text-wrap: balance; }
  .hm h2 { font-family: var(--fd); font-weight: 600; font-size: clamp(23px, 3.6vw, 32px); line-height: 1.15; margin: 0 0 8px; }
  .hm .eyebrow { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--teal-soft); margin: 0 0 12px; }
  .hm .lede { color: #C6CBD2; font-size: 17px; max-width: 62ch; margin: 8px 0 0; }
  .hm .muted { color: var(--muted); font-size: 14px; margin-top: 16px; }
  .hm a { color: var(--teal-soft); }
  .covers { display: grid; grid-template-columns: 1fr 1fr; gap: 36px; align-items: start; margin-top: 28px; }
  .covlist { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 16px; }
  .covlist li { font-size: 15px; line-height: 1.5; padding-left: 30px; position: relative; }
  .covlist li::before { content: ''; position: absolute; left: 0; top: 2px; width: 20px; height: 20px; border-radius: 6px; background: var(--teal-soft); }
  .covlist li::after { content: ''; position: absolute; left: 6px; top: 8px; width: 8px; height: 4px; border-left: 2px solid #06231F; border-bottom: 2px solid #06231F; transform: rotate(-45deg); }
  .covlist b { color: var(--teal-soft); font-weight: 600; }
  .covcard { background: #141C28; border: 1px solid #243040; border-radius: 16px; padding: 32px 26px; text-align: center; }
  .covnum { font-family: var(--fd); font-weight: 600; font-size: clamp(56px, 9vw, 78px); line-height: 1; color: var(--teal-soft); letter-spacing: -.02em; }
  .covnum-label { color: var(--muted); font-size: 15px; margin: 8px 0 0; }
  .covcalc { margin: 20px 0 0; text-align: left; display: flex; flex-direction: column; gap: 8px; }
  .covcalc > div { display: flex; gap: 12px; align-items: baseline; }
  .covcalc dt { color: var(--teal-soft); font-weight: 600; font-variant-numeric: tabular-nums; min-width: 32px; text-align: right; }
  .covcalc dd { margin: 0; color: var(--muted); font-size: 13.5px; line-height: 1.45; }
  .covtags-head { margin-top: 22px; }
  .covtags { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; margin-top: 12px; }
  .covtags span { background: rgba(93,209,193,.08); border: 1px solid rgba(93,209,193,.22); color: var(--teal-soft); font-size: 11.5px; font-weight: 600; padding: 5px 11px; border-radius: 20px; }
  .covfoot { margin: 20px 0 0; font-size: 12.5px; color: var(--muted); line-height: 1.5; }
  @media (max-width: 760px) { .covers { grid-template-columns: 1fr; gap: 28px; } .covcard { padding: 26px 18px; } }

  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }

  .hero { text-align: center; padding-block: 56px 40px; }
  .hero h1 { font-family: var(--fd); font-weight: 600; font-size: clamp(30px, 5.2vw, 50px); line-height: 1.1; letter-spacing: -.015em; margin: 0 0 16px; }
  .hero h1 em { font-style: normal; color: var(--teal-soft); }
  .hero .lede { margin: 0 auto 26px; }
  .check { display: flex; gap: 10px; max-width: 520px; margin: 0 auto; flex-wrap: wrap; }
  .check input { flex: 1 1 240px; min-width: 0; height: 54px; background: #141C28; border: 1px solid #243040; border-radius: 10px; padding: 0 16px; color: var(--paper); font: inherit; font-size: 16px; }
  .check input::placeholder { color: var(--muted); }
  .check input:focus { outline: 2px solid var(--teal-soft); outline-offset: 1px; }
  .check button { height: 54px; padding: 0 26px; background: var(--teal-soft); color: #06231F; border: 0; border-radius: 10px; font: inherit; font-size: 16px; font-weight: 600; cursor: pointer; white-space: nowrap; }
  .check button:hover { background: #4fc9ba; }
  .under { margin: 14px 0 0; font-size: 13px; color: var(--muted); }
  .under b { color: var(--paper); font-weight: 500; }

  .sample { background: #141C28; border: 1px solid #243040; border-radius: 16px; padding: 22px; margin-top: 34px; text-align: left; }
  .sample-top { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .num { font-family: var(--fd); font-weight: 600; font-size: 58px; line-height: 1; color: var(--amber-soft); }
  .num span { font-size: 20px; color: var(--muted); }
  .sample-top p { margin: 0; font-size: 14px; color: #C6CBD2; flex: 1 1 260px; min-width: 0; }
  .bars { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 20px; }
  .bar-label { font-size: 12px; color: var(--muted); margin: 0 0 6px; line-height: 1.35; min-height: 2.7em; }
  .track { height: 7px; background: #0E1520; border-radius: 4px; overflow: hidden; }
  .fill { height: 100%; background: var(--teal); border-radius: 4px; }
  .fill.low { background: #C9922A; }
  .val { font-size: 12px; color: var(--paper); margin: 6px 0 0; font-variant-numeric: tabular-nums; }

  .three { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 24px; }
  .card { background: #141C28; border: 1px solid #243040; border-radius: 14px; padding: 22px; }
  .card h3 { font-size: 17px; font-weight: 600; margin: 0 0 8px; }
  .card p { margin: 0; font-size: 15px; color: #C6CBD2; }
  .tag { display: inline-block; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--teal-soft); margin: 0 0 12px; }

  .steps { list-style: none; counter-reset: s; display: grid; gap: 14px; margin: 22px 0 0; padding: 0; max-width: 760px; }
  .steps li { counter-increment: s; display: flex; gap: 16px; align-items: flex-start; }
  .steps li > div { flex: 1; min-width: 0; }
  .steps li::before { content: counter(s); flex: 0 0 34px; height: 34px; border-radius: 50%; background: #1B2533; color: var(--teal-soft); font-family: var(--fd); font-size: 16px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  .steps b { display: block; color: var(--paper); font-weight: 500; font-size: 16px; }
  .steps p { margin: 4px 0 0; font-size: 15px; color: #C6CBD2; }

  .honest { background: #141C28; border: 1px solid #243040; border-left: 3px solid var(--amber-soft); border-radius: 0 14px 14px 0; padding: 22px 24px; margin-top: 20px; max-width: 760px; }
  .honest p { margin: 0 0 10px; font-size: 15px; color: #C6CBD2; }
  .honest p:last-child { margin: 0; }
  .honest b { color: var(--paper); font-weight: 500; }
  .honest b.amber { color: var(--amber-soft); font-weight: 600; }

  .mods { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px; margin-top: 22px; }
  .mod { background: #141C28; border: 1px solid #243040; border-radius: 10px; padding: 14px 16px; }
  .mod.core { border-color: var(--teal); }
  .mod b { display: block; font-size: 14px; font-weight: 500; }
  .mod span { display: block; font-size: 12px; color: var(--muted); margin: 2px 0 8px; }
  .mod p { margin: 0; font-size: 13px; color: #B8BFC7; line-height: 1.45; }

  .final { text-align: center; padding-block: 60px; }
  .final h2 { font-size: clamp(24px, 4vw, 36px); }
  .final .lede { margin: 0 auto 24px; }
  @media (max-width: 560px) { .hm section { padding-block: 40px; } .num { font-size: 46px; } }

  /* Три отличия под кнопкой: в строку на широком экране, столбиком на телефоне. */
  .edge { list-style: none; margin: 22px auto 0; padding: 0; max-width: 680px; display: grid; gap: 14px; grid-template-columns: repeat(2, 1fr); text-align: left; }
  .edge li { font-size: 14px; line-height: 1.5; color: rgba(245,242,236,.72); padding-left: 14px; border-left: 2px solid rgba(61,184,169,.55); }
  .edge b { display: block; color: var(--paper); font-weight: 600; margin-bottom: 2px; }
  @media (max-width: 760px) { .edge { grid-template-columns: 1fr; gap: 12px; margin-top: 18px; } }
  /* Переупаковка 25.09.2026 */
  .hero .eyebrow { margin-bottom: 14px; }
  .ask { background: #141C28; border: 1px solid #243040; border-radius: 16px; padding: 22px 24px; margin-top: 22px; max-width: 760px; }
  .ask-q { margin: 0 0 16px; font-size: 18px; color: var(--paper); font-weight: 500; }
  .ask-q span { display: block; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; font-weight: 400; }
  .ask-l { margin: 0 0 8px; font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); }
  .ask-names { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .ask-names li { background: rgba(255,255,255,.05); border: 1px solid #2A3647; border-radius: 20px; padding: 6px 12px; font-size: 14px; color: #D6DAE0; }
  .ask-you { margin: 18px 0 0; font-size: 16px; color: var(--amber-soft); }
  .ask-you b { color: var(--paper); font-weight: 500; }
  .ask-foot { margin: 14px 0 0; font-size: 13px; color: var(--muted); line-height: 1.5; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; align-items: center; }
  .btn-main { display: inline-flex; align-items: center; height: 50px; padding: 0 24px; background: var(--teal-soft); color: #06231F !important; border-radius: 10px; font-weight: 600; text-decoration: none; }
  .btn-ghost { display: inline-flex; align-items: center; height: 50px; padding: 0 20px; border: 1px solid #2A3647; border-radius: 10px; color: var(--paper) !important; text-decoration: none; }
  .vs { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 14px; margin-top: 24px; }
  .vs-card { background: #141C28; border: 1px solid #243040; border-radius: 14px; padding: 20px; }
  .vs-card.us { border-color: var(--teal); background: rgba(61,184,169,.07); }
  .vs-price { margin: 0 0 8px; font-size: 17px; font-weight: 600; color: var(--paper); }
  .vs-card p:last-child { margin: 0; font-size: 14.5px; color: #C6CBD2; }
  .src { margin: 14px 0 0; font-size: 12.5px; color: var(--muted); }
  .proof { margin-top: 22px; }
  .proof-big { font-family: var(--fd); font-weight: 600; font-size: clamp(52px, 9vw, 76px); line-height: 1; color: var(--teal-soft); }
  .proof-line { margin: 10px 0 0; font-size: 18px; color: var(--paper); max-width: 40ch; }
  .proof-src { margin: 8px 0 0; font-size: 13.5px; color: var(--muted); }
  .small { margin: 16px 0 0; font-size: 13px; color: var(--muted); }
  .faq { margin-top: 18px; max-width: 760px; display: grid; gap: 10px; }
  .faq details { background: #141C28; border: 1px solid #243040; border-radius: 12px; padding: 14px 18px; }
  .faq summary { cursor: pointer; font-weight: 500; color: var(--paper); }
  .faq p { margin: 10px 0 0; font-size: 15px; color: #C6CBD2; }
  .oneoff { margin: 18px 0 0; font-size: 14px; color: var(--muted); }
</style>
