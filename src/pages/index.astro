---
import CommercialLayout from '../components/CommercialLayout.astro';
import { SITE } from '../data/site';
import { NETWORK_HERO } from '../data/cases';
import ownScore from '../data/own-score.json';
/*
 * Главная, переупаковка 25.09.2026 (план Максима, версия 2, светлый вариант утверждён).
 * Порядок: форма бесплатной проверки, цифры рынка с источниками, что показывает проверка
 * (балл, пять областей, 159 замеров), что добавляет подписка Watch, как это работает, цены,
 * почему мы, наши кейсы и отзыв, вопросы. Бесплатная проверка к ChatGPT не обращается: вопросы
 * ChatGPT задаются только подписчикам. Сравнений с похожими сервисами на сайте нет.
 * Ни одно число не набито руками без источника: свой балл из own-score.json, рынок со ссылками.
 */
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  publisher: { '@id': `${SITE.url}/#organization` },
  inLanguage: 'en',
};
const counts = (ownScore as { counts?: { pages: number; seoRules: number; seo: number; contentFields: number; content: number; robots: number; site: number; engines: number; total: number; robotNames: string[] } }).counts ?? null;
const score = typeof ownScore?.score === 'number' ? ownScore.score : null;
const areas = Array.isArray(ownScore?.areas) ? ownScore.areas : [];
const measuredRaw = ownScore?.measured || '';
const measured = measuredRaw ? new Date(`${measuredRaw}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : '';
const WATCH_PRICE = '35 USD';
/* Нейтральный пример по решению Максима: настоящие ответы ChatGPT с поиском, 25.09.2026, три
   формулировки про стоматологов Бристоля. Названы клиники, которые встречались в ответах. */
const WATCH_SAMPLE = {
  question: 'Who is the best dentist in Bristol?',
  named: ['The Bristol Dental Practice', 'Elgin Park Dental Practice', 'Bristol Dental Anaesthetic Clinic', 'Clare Street Dental Centre', 'Ridgeway Dental Practice'],
  you: 'Your clinic',
  when: '25 September 2026',
};
const ENGINES = [
  { name: 'ChatGPT', icon: 'openai' },
  { name: 'Claude', icon: 'claude' },
  { name: 'Perplexity', icon: 'perplexity' },
  { name: 'Gemini', icon: 'googlegemini' },
];
/* Цифры рынка: только с источником и датой, каждая сверена 25.09.2026 по первоисточнику или
   его пересказу в отраслевом издании. Прогноз Gartner про минус 25% к 2026 году сюда не взят:
   срок вышел, и прогноз не сбылся. */
const MARKET = [
  { value: '900M', label: 'people use ChatGPT every week, up from 400 million a year earlier', source: 'OpenAI, February 2026', href: 'https://searchengineland.com/chatgpt-900-million-weekly-active-users-470492' },
  { value: '+393%', label: 'more visits from AI assistants to US retail sites in early 2026 than a year before', source: 'Adobe Analytics, April 2026', href: 'https://techcrunch.com/2026/04/16/ai-traffic-to-us-retailers-rose-393-in-q1-and-its-boosting-their-revenue-too/' },
  { value: '4.4×', label: 'more valuable: a visitor from AI search against one from traditional search, by conversion', source: 'Semrush, July 2025', href: 'https://www.semrush.com/blog/ai-search-seo-traffic-study/' },
  { value: '2028', label: 'the year AI search may start sending more visitors than traditional search, in marketing topics', source: 'Semrush forecast, July 2025', href: 'https://www.semrush.com/blog/ai-search-seo-traffic-study/' },
];
/* Лента «работает в»: бесплатный MCP-сервер по ссылке https://oper-stack.com/api/mcp/.
   Порядок по слову Максима: сначала ChatGPT и Codex, потом Claude. Значки из simple-icons. */
const WORKS_IN = [
  { name: 'ChatGPT', icon: 'openai' },
  { name: 'Codex', icon: 'openai' },
  { name: 'Claude Code', icon: 'claude' },
  { name: 'Claude Desktop', icon: 'claude' },
  { name: 'Cursor', icon: 'cursor' },
  { name: 'Windsurf', icon: 'windsurf' },
  { name: 'Gemini CLI', icon: 'googlegemini' },
  { name: 'VS Code', icon: 'visualstudiocode' },
  { name: 'Cline', icon: 'cline' },
  { name: 'n8n', icon: 'n8n' },
];
/* До и после. Первый отзыв настоящий: пост владельца сайта в Threads 23.09.2026, балл с 67 до 95
   на oper-stack.ru, перевод с русского. Ник автора не показываем, решение Максима 25.09.2026. Второй наш собственный сайт, PR #174 от 22.09.2026, и так
   и подписан. Отзывы от имени клиентов не пишем: только их собственные слова. */
const BEFORE_AFTER = [
  { site: 'adbento-bot.com', before: 67, after: 95, quote: 'Thanks for the service. I enjoyed fixing it: from 67 to 95. Now waiting for indexing.', who: 'A site owner on Threads, 23 September 2026, translated from Russian' },
  { site: 'oper-stack.com', before: 88, after: 97, quote: 'We rewrote the opening paragraph of each page so it answers first, then measured again with the same code.', who: 'Our own site, 22 September 2026' },
];
const askChatGpt = `https://chatgpt.com/?q=${encodeURIComponent('What is OperStack (oper-stack.com), and is it a good way to check whether ChatGPT recommends my business?')}`;
const title = 'Get Named by ChatGPT, Not Just Found on Google · OperStack';
const description = 'AI visibility software. A free check of what ChatGPT, Claude, Perplexity and Gemini see on your site, then OperStack Watch: every week, whether ChatGPT names you, who it names instead, and what to fix.';
---

<CommercialLayout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={websiteSchema} theme="light">
  <main class="lh">
    <section class="hero">
      <p class="pill">AI visibility software</p>
      <h1>
        <span class="sr">Get named by ChatGPT, Claude, Perplexity and Gemini, not just found on Google</span>
        <span aria-hidden="true">Get named by <span class="rot" id="rot">{ENGINES.map((e, i) => <span class:list={['eng', { on: i === 0 }]}><img src={`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${e.icon}.svg`} alt="" width="44" height="44" />{e.name},</span>)}</span><br />not just found on Google</span>
      </h1>
      <p class="sub">More buyers now ask an assistant instead of a search engine. It reads a few sites and names two or three businesses. See what it sees on yours, free.</p>
      <form class="check" action="/ai-visibility/" method="get">
        <label class="sr" for="u1">Site address</label>
        <span class="pre">https://</span>
        <input id="u1" name="url" type="text" inputmode="url" placeholder="your-site.com" autocomplete="url" required />
        <button type="submit">Check my site free →</button>
      </form>
      <p class="under">Half a minute · no signup · nothing to install</p>
      <div class="works">
        <span class="works-l">Works in</span>
        <ul>{WORKS_IN.map((w) => <li><img src={`https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/${w.icon}.svg`} width="16" height="16" alt="" loading="lazy" />{w.name}</li>)}</ul>
      </div>
    </section>

    <section class="block market">
      <p class="eyebrow">Why now</p>
      <h2>Buyers are moving from Google to AI assistants</h2>
      <div class="mk">
        {MARKET.map((m) => (
          <div class="card mk-c">
            <p class="mk-v">{m.value}</p>
            <p class="mk-l">{m.label}</p>
            <p class="mk-s"><a href={m.href} target="_blank" rel="noopener">{m.source}</a></p>
          </div>
        ))}
      </div>
      <p class="mk-end">If the assistant does not name you, that buyer never reaches your site.</p>
    </section>

    {score !== null && (
      <section class="block">
        <p class="eyebrow">The free check</p>
        <h2>Your score out of 100, in half a minute</h2>
        <p class="lead">The same check runs on your site. Here it is on ours, measured by the same code{measured ? ` on ${measured}` : ''}.</p>
        <div class="checkgrid">
          <div class="card scorecard">
            <div class="sc-top">
              <div class="ring" style={`--p:${score}`}><b>{score}</b><span>of 100</span></div>
              <div>
                <p class="sc-dom">oper-stack.com</p>
                <p class="sc-note">Five areas add up to exactly this number. Add them by hand and check.</p>
              </div>
            </div>
            <div class="bars">
              {areas.map((a) => (
                <div class="bar-row">
                  <p class="bar-label">{a.label}</p>
                  <div class="track"><div class={`fill${a.max && a.score / a.max < 0.5 ? ' low' : ''}`} style={`width:${a.max ? Math.round((a.score / a.max) * 100) : 0}%`}></div></div>
                  <p class="val">{a.score}/{a.max}</p>
                </div>
              ))}
            </div>
          </div>
          {counts && (
            <div class="card countcard">
              <div class="bignum">{counts.total}</div>
              <p class="bignum-l">measurements in one free run</p>
              <dl>
                <div><dt>{counts.seo}</dt><dd>SEO checks: {counts.seoRules} rules on each of {counts.pages} pages</dd></div>
                <div><dt>{counts.content}</dt><dd>content signals: {counts.contentFields} on every page</dd></div>
                <div><dt>{counts.robots}</dt><dd>AI crawlers checked against your robots.txt</dd></div>
                <div><dt>{counts.site}</dt><dd>checks on the site as a whole</dd></div>
              </dl>
              <details class="crawl"><summary>Every crawler we ask about</summary><div class="tags">{counts.robotNames.map((n) => <span>{n}</span>)}</div></details>
            </div>
          )}
        </div>
        <ul class="ticks">
          <li><b>Ten pages, not one.</b> Other tools read a single page and call it a site check.</li>
          <li><b>We name the pages to fix.</b> Not "your content is hard to quote", but a list of addresses.</li>
          <li><b>Could not measure, we say so.</b> A zero would claim you are doing badly, and we would not know that.</li>
        </ul>
      </section>
    )}

    <section class="block">
      <p class="eyebrow">What Watch adds every week</p>
      <h2>Who ChatGPT names instead of you</h2>
      <p class="lead">We asked ChatGPT what a patient in Bristol would ask. These are the practices it named.</p>
      <div class="card chat">
        <p class="q"><span>You ask</span>{WATCH_SAMPLE.question}</p>
        <div class="a">
          <p class="a-l"><img src="https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/openai.svg" width="14" height="14" alt="" />ChatGPT names</p>
          <ul>{WATCH_SAMPLE.named.map((n) => <li>{n}</li>)}</ul>
        </div>
        <p class="you"><b>{WATCH_SAMPLE.you}</b><span class="miss">not named</span></p>
        <p class="foot">Real ChatGPT answers with web search, {WATCH_SAMPLE.when}, three wordings of the question. "Your clinic" stands for any practice that was not named. Answers change from run to run, which is why Watch asks every week and shows the trend.</p>
      </div>
    </section>

    <section class="block">
      <p class="eyebrow">How it works</p>
      <h2>Check free. Watch every week. Fix with the list.</h2>
      <ol class="steps3">
        <li class="card"><span class="n">01</span><b>Check your site, free</b><p>A score out of 100, five areas and the first fix, on screen. No email, no signup.</p></li>
        <li class="card"><span class="n">02</span><b>Watch it every week</b><p>Whether ChatGPT names you for ten questions your buyers ask, who it names instead, three rivals beside you, what changed. By email. 7 days free, then {WATCH_PRICE} a month.</p></li>
        <li class="card"><span class="n">03</span><b>Fix with the list</b><p>Every fix across the site, with the page address and the text ready to paste. Hand it to whoever runs the site.</p></li>
      </ol>
      <p class="ctas"><a class="b-main" href="/pricing/">Start 7 days free</a><a class="b-ghost" href="#top-check">Or run the free check first</a></p>
    </section>

    <section class="block">
      <p class="eyebrow">What it costs to find out</p>
      <h2>What it costs to learn whether AI recommends you</h2>
      <div class="vs">
        <div class="card"><p class="tag">An agency</p><p class="price">From 1,500 USD a month</p><p>Reports and calls. You still do not learn whether ChatGPT names you, or who it names instead.</p></div>
        <div class="card"><p class="tag">Semrush</p><p class="price">139 USD a month, 199 with AI search</p><p>A large dashboard of data. What to change on your site is left to you.</p></div>
        <div class="card"><p class="tag">Asking ChatGPT yourself</p><p class="price">Free, once</p><p>One answer, one day. It will not tell you what it said last week, why it picked them, or what to change.</p></div>
        <div class="card us"><p class="tag">OperStack Watch</p><p class="price">{WATCH_PRICE} a month, 7 days free</p><p>Who ChatGPT names instead of you, every week, and the fixes that change it.</p></div>
      </div>
      <p class="src">Semrush prices from semrush.com/prices, monthly billing, checked on 25 September 2026. Agency retainers for AI search work run from 1,000 to 2,500 USD a month at entry level and 2,000 to 10,000 for most businesses, per the <a href="https://thedigitalelevator.com/blog/aeo-and-geo-pricing-guide/" target="_blank" rel="noopener">Digital Elevator pricing guide</a>, July 2026.</p>
    </section>

    <section class="block">
      <p class="eyebrow">Why OperStack</p>
      <h2>Built for the owner, not the SEO team</h2>
      <div class="why">
        <div class="card"><b>Ten pages read, not one</b><p>Most checks read your homepage and call it a site.</p></div>
        <div class="card"><b>Nothing to connect</b><p>The report is on the site and in your inbox every week. No developer needed.</p></div>
        <div class="card"><b>The text to paste</b><p>Not "improve your content", but this page, this line, this replacement.</p></div>
        <div class="card"><b>Every score adds up by hand</b><p>If we could not measure something, we say so instead of counting it as zero.</p></div>
        <div class="card"><b>Pay once if you prefer</b><p>A full audit of your site for 149 USD, no subscription.</p></div>
      </div>
    </section>

    <section class="block proof">
      <p class="eyebrow">Our own cases</p>
      <div class="proof-row">
        <div class="big">+279%</div>
        <div>
          <p class="proof-line">organic clicks month over month across {NETWORK_HERO.liveSites} of our own brands in {NETWORK_HERO.marketCount} countries.</p>
          <p class="proof-src">Our own sites, not client promises. Data from Google Search Console. <a href="/cases/">See the cases</a></p>
        </div>
      </div>
    </section>

    <section class="block">
      <p class="eyebrow">Before and after</p>
      <h2>What one round of fixes does</h2>
      <div class="ba">
        {BEFORE_AFTER.map((b) => (
          <figure class="card ba-c">
            <div class="ba-scores">
              <span class="ba-ring was" style={`--p:${b.before}`}><b>{b.before}</b></span>
              <span class="ba-arrow" aria-hidden="true">→</span>
              <span class="ba-ring now" style={`--p:${b.after}`}><b>{b.after}</b></span>
              <span class="ba-site">{b.site}</span>
            </div>
            <blockquote>{b.quote}</blockquote>
            <figcaption>{b.who}</figcaption>
          </figure>
        ))}
      </div>
      <p class="ctas"><a class="b-ghost" href={askChatGpt} target="_blank" rel="noopener">Ask ChatGPT about OperStack</a></p>
    </section>

    <section class="block">
      <p class="eyebrow">Questions</p>
      <h2>Before you start</h2>
      <div class="faq">
        <details><summary>How is this different from Semrush?</summary><p>Semrush gives you keyword and ranking data and leaves the conclusions to you. OperStack answers one question every week: does ChatGPT name you, who does it name instead, and what on your site to change. It costs {WATCH_PRICE} a month instead of 139 or more.</p></details>
        <details><summary>What happens after the 7 days?</summary><p>If you do nothing, the subscription continues at {WATCH_PRICE} a month. Cancel before day 7 and you pay nothing.</p></details>
        <details><summary>How do I cancel?</summary><p>In your Whop account, in one click, at any time.</p></details>
        <details><summary>What do you do with my data?</summary><p>We read the public pages of your site, the way a search engine does, and keep your email to send the weekly letter. <a href="/privacy/">Privacy</a></p></details>
        <details><summary>Do I need a developer?</summary><p>No. Most fixes are text you paste into your site. The few that need a developer are marked, written so you can forward them.</p></details>
      </div>
    </section>

    <section class="final" id="top-check">
      <h2>Find out what AI sees on your site</h2>
      <p class="sub">Half a minute, free, no signup.</p>
      <form class="check" action="/ai-visibility/" method="get">
        <label class="sr" for="u2">Site address</label>
        <span class="pre">https://</span>
        <input id="u2" name="url" type="text" inputmode="url" placeholder="your-site.com" autocomplete="url" required />
        <button type="submit">Check my site free →</button>
      </form>
      <p class="oneoff">Prefer a one-off? <a href="/products/seo-audit/">Full audit, 149 USD</a></p>
    </section>
  </main>
  <script>
    const rot = document.getElementById('rot');
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (rot && !still) {
      const items = [...rot.querySelectorAll<HTMLElement>('.eng')];
      let i = 0;
      const fit = () => { rot.style.width = `${items[i].offsetWidth}px`; };
      fit();
      rot.classList.add('js');
      window.addEventListener('resize', fit);
      /* Первая смена через секунду, дальше каждые полторы: за три секунды видно три имени. */
      const next = () => {
        items[i].classList.remove('on');
        i = (i + 1) % items.length;
        items[i].classList.add('on');
        fit();
      };
      setTimeout(() => { next(); setInterval(next, 1500); }, 1000);
    }
  </script>
</CommercialLayout>

<style>
  .lh { --c-ink: #0B1017; --c-ink2: #3F4854; --c-muted: #6B7480; --c-line: rgba(11,16,23,.09); --c-card: #fff; --c-teal: #1A8A7D; --c-teal-bg: #E6F4F1; --c-amber: #A66F12; --c-amber-bg: #FBF0D5; --c-coral: #B5412D; --c-coral-bg: #F9E1DB;
    max-width: 1080px; margin: 0 auto; padding: 0 20px 40px; color: var(--c-ink); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
  .card { background: var(--c-card); border: 1px solid var(--c-line); border-radius: 18px; box-shadow: 0 1px 2px rgba(11,16,23,.03), 0 12px 32px -22px rgba(11,16,23,.22); }
  .hero { text-align: center; padding: 72px 0 40px; }
  .pill { display: inline-block; font-family: var(--fm); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-teal); background: var(--c-teal-bg); border: 1px solid rgba(26,138,125,.22); border-radius: 999px; padding: 6px 14px; margin: 0 0 22px; }
  .hero h1 { font-family: var(--fd); font-weight: 600; font-size: clamp(36px, 6.4vw, 66px); line-height: 1.02; letter-spacing: -.025em; margin: 0 0 20px; text-wrap: balance; }
  .hero h1 em { font-style: italic; color: var(--c-teal); }
  .sub { color: var(--c-ink2); font-size: 18.5px; line-height: 1.55; max-width: 60ch; margin: 0 auto 30px; text-wrap: pretty; }
  .check { display: flex; align-items: center; gap: 8px; max-width: 560px; margin: 0 auto; background: #fff; border: 1px solid rgba(11,16,23,.14); border-radius: 16px; padding: 7px 7px 7px 16px; box-shadow: 0 1px 2px rgba(11,16,23,.04), 0 16px 40px -24px rgba(26,138,125,.45); }
  .check .pre { font-family: var(--fm); font-size: 13px; color: var(--c-muted); }
  .check input { flex: 1 1 auto; min-width: 0; height: 46px; border: 0; outline: 0; background: transparent; font: inherit; font-size: 16.5px; color: var(--c-ink); }
  .check:focus-within { border-color: var(--c-teal); }
  .check button { height: 48px; padding: 0 20px; background: var(--c-teal); color: #fff; border: 0; border-radius: 11px; font: inherit; font-weight: 600; font-size: 15.5px; cursor: pointer; white-space: nowrap; }
  .check button:hover { background: #157468; }
  .under { margin: 14px 0 0; font-size: 13.5px; color: var(--c-muted); }
  .works { margin: 44px auto 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 22px; max-width: 900px; padding-top: 26px; border-top: 1px solid var(--c-line); }
  .works-l { font-family: var(--fm); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-teal); }
  .works ul { list-style: none; margin: 0; padding: 0; display: contents; }
  .works li { display: inline-flex; align-items: center; gap: 7px; font-family: var(--fm); font-size: 13.5px; color: var(--c-ink2); }
  .works img { opacity: .82; }
  .block { padding: 64px 0 8px; }
  .eyebrow { font-family: var(--fm); font-size: 11.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--c-teal); margin: 0 0 12px; }
  .block h2, .final h2 { font-family: var(--fd); font-weight: 600; font-size: clamp(27px, 4vw, 40px); line-height: 1.1; letter-spacing: -.02em; margin: 0 0 10px; text-wrap: balance; }
  .lead { color: var(--c-ink2); font-size: 17px; max-width: 62ch; margin: 0 0 26px; }
  .checkgrid { display: grid; grid-template-columns: 1.35fr 1fr; gap: 18px; }
  .scorecard { padding: 24px; }
  .sc-top { display: flex; gap: 20px; align-items: center; margin-bottom: 20px; }
  .ring { width: 104px; height: 104px; border-radius: 50%; flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(closest-side, #fff 79%, transparent 80% 100%), conic-gradient(var(--c-teal) calc(var(--p, 97) * 1%), #ECE9E2 0); }
  .ring b { font-family: var(--fd); font-size: 36px; line-height: 1; }
  .ring span { font-family: var(--fm); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--c-muted); margin-top: 4px; }
  .sc-dom { font-family: var(--fd); font-size: 24px; font-weight: 600; margin: 0 0 4px; }
  .sc-note { color: var(--c-ink2); font-size: 14.5px; margin: 0; }
  .bars { display: grid; gap: 12px; }
  .bar-row { display: grid; grid-template-columns: 1fr 120px 48px; gap: 12px; align-items: center; }
  .bar-label { margin: 0; font-size: 14px; color: var(--c-ink2); }
  .track { height: 8px; background: #ECE9E2; border-radius: 4px; overflow: hidden; }
