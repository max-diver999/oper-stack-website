---
import CommercialLayout from '../components/CommercialLayout.astro';
import { SITE } from '../data/site';
import { MAP_CORE, MAP_MODULES } from '../data/map-copy';
import ownScore from '../data/own-score.json';

/*
 * The homepage is the free check. Variant A, approved by Maxim on 15 Sep 2026: the first screen
 * asks the question and offers the form; below it three reasons to run it, how it works, what
 * makes it different, what happens after the check (no prices here: they live in the email),
 * and the modules as text instead of the interactive map. Not one number typed by hand: our own
 * score comes from own-score.json, which the build measures with the same code as the check.
 */
const score = typeof ownScore?.score === 'number' ? ownScore.score : null;
const areas = Array.isArray(ownScore?.areas) ? ownScore.areas : [];
const measured = ownScore?.measured || '';
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  publisher: { '@id': `${SITE.url}/#organization` },
  inLanguage: 'en',
};
const title = 'Free AI Visibility Check: Your Site Through the Eyes of AI · OperStack';
const description = 'Generative engine optimization starts with a measurement. What ChatGPT, Claude, Perplexity, Gemini, Copilot and the rest see on your site: which of the 14 AI crawlers it lets in, whether it has a map for agents, whether there is anything to quote. A score out of 100 and the first fix on screen, no signup.';
---
<CommercialLayout title={title} description={description} canonical={`${SITE.url}/`} jsonLd={websiteSchema}>
  <main class="hm">

    <section class="hero">
      <h1>Your site through the eyes of <em>AI</em></h1>
      <p class="lede">People increasingly ask an assistant instead of a search engine: ChatGPT, Claude, Perplexity, Gemini, Copilot and the rest. The assistant reads a few sites and names two or three. This check shows what it sees on yours, whether you make that list, and what stands in the way.</p>
      <form class="check" action="/ai-visibility/" method="get">
        <label class="sr" for="home-url">Site address</label>
        <input id="home-url" name="url" type="text" inputmode="url" placeholder="your-site.com" autocomplete="url" required />
        <button type="submit">Check for free</button>
      </form>
      <p class="under">Half a minute · no signup · nothing to install · <b>result on screen</b></p>

      {score !== null && (
        <div class="sample" aria-label="What the result looks like">
          <div class="sample-top">
            <div class="num">{score}<span>/100</span></div>
            <p>This is what the answer looks like: our own site, measured by the same code{measured ? ` on ${measured}` : ''}. The score is the sum of five areas; add them up by hand and you get exactly this number. Below it the check lists which of the 14 AI crawlers a site lets in and which it turns away.</p>
          </div>
          <div class="bars">
            {areas.map((a) => (
              <div>
                <p class="bar-label">{a.label}</p>
                <div class="track"><div class={`fill${a.max && a.score / a.max < 0.5 ? ' low' : ''}`} style={`width:${a.max ? Math.round((a.score / a.max) * 100) : 0}%`}></div></div>
                <p class="val">{a.score} of {a.max}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>

    <section>
      <p class="eyebrow">Why people run it</p>
      <h2>One check, three different reasons</h2>
      <div class="three">
        <div class="card"><span class="tag">Your own site</span><h3>Why does the assistant name someone else</h3><p>The site is alive and the copy is good, yet you are not in the AI answers. Usually it is not the copy but three files a robot looks for and cannot find. The check names them.</p></div>
        <div class="card"><span class="tag">Rivals</span><h3>Who gets named instead of you, and why</h3><p>Run a rival through the same tool and compare the five areas side by side. You see exactly where they are ahead, and it is a measurement of their site, not a guess.</p></div>
        <div class="card"><span class="tag">Clients</span><h3>For a marketer: a reason to start the conversation</h3><p>Check a client's site before the meeting. Come not with "let's do promotion" but with specifics: this is closed, this is missing, this is what it costs.</p></div>
      </div>
    </section>

    <section>
      <p class="eyebrow">How it works</p>
      <h2>We read your site the way an AI crawler reads it</h2>
      <ol class="steps">
        <li><div><b>We knock the way an assistant knocks</b><p>We see whether the site lets in the 14 crawlers that fetch pages for ChatGPT, Perplexity, Claude and Copilot answers. One line in robots.txt can close you to all of them at once.</p></div></li>
        <li><div><b>We look for the map for agents</b><p>llms.txt is a short list of your pages written for a machine. Most sites we have checked do not have one.</p></div></li>
        <li><div><b>We check whether it is clear who you are</b><p>Structured data should name what you actually do. A dental clinic should be marked as a dental clinic, not as "an organisation".</p></div></li>
        <li><div><b>We look for something to quote</b><p>An assistant takes a short, ready answer from the first paragraph. If the page opens with the company history, there is nothing to quote.</p></div></li>
        <li><div><b>We check whether you can be trusted</b><p>Dates, authorship, sources under the figures. A figure without a source is not a fact to a machine.</p></div></li>
      </ol>
    </section>

    <section>
      <p class="eyebrow">What makes it different</p>
      <h2>We only say what we measured</h2>
      <div class="honest">
        <p><b>The score can be checked by hand.</b> Five areas add up to exactly the number at the top. No weight taken from thin air.</p>
        <p><b>Could not measure, we say so.</b> If a file could not be read, the area is marked "not measured" and counts neither for nor against. A zero would claim you are doing badly, and we do not know that.</p>
        <p><b>No "our AI thinks".</b> Every finding is a specific file, a line, or its absence. Open it and see for yourself.</p>
        <p><b>This work has names.</b> GEO, generative engine optimization, and AEO, answer engine optimization. We measure the things behind the names rather than the names: the files, the markup and the text. <a href="/guides/ai-seo/">What it is and what decides it</a>.</p>
        {score !== null && <p><b>And we measure ourselves with the same tool.</b> This site scores <b class="amber">{score} of 100</b>{measured ? ` as of ${measured}` : ''}. Same code, same settings, and the number is refreshed every time the site is built.</p>}
      </div>
    </section>

    <section>
      <p class="eyebrow">After the check</p>
      <h2>First you get the result. Then you decide whether you need more</h2>
      <ol class="steps">
        <li><div><b>The score and five areas, on screen</b><p>No email, no signup. That already answers whether AI sees you.</p></div></li>
        <li><div><b>The first fix, in full</b><p>The most important one: what is there now, what to change, how to check it worked. On screen, and by email if you leave one, so you can hand it to whoever runs the site.</p></div></li>
        <li><div><b>More only if you want it</b><p>Every fix across the whole site, a comparison with rivals, a review by a person. We write about that in the same email, and the prices are there, not here. <a href="/products/">See what there is</a>.</p></div></li>
      </ol>
    </section>

    <section>
      <p class="eyebrow">Why trust us</p>
      <h2>We built this for ourselves, then gave it to people</h2>
      <p class="lede">Fifteen sites of our own, more than two million words, {MAP_MODULES.length} modules around one hub. The tool grew out of what we fixed on our own sites every day.</p>
      <div class="mods">
        <div class="mod core"><b>{MAP_CORE.title}</b><span>{MAP_CORE.role}</span><p>{MAP_CORE.lede}</p></div>
        {MAP_MODULES.map((m) => (
          <div class="mod"><b>{m.name}</b><span>{m.role}{m.proof ? ` · ${m.proof}` : ''}</span><p>{m.lede}</p></div>
        ))}
      </div>
      <p class="muted">Need the system rather than the tool? <a href="/services/">See the services</a>.</p>
    </section>

    <section class="final">
      <h2>The check takes half a minute</h2>
      <p class="lede">Knowing whether AI sees you costs less than not knowing.</p>
      <form class="check" action="/ai-visibility/" method="get">
        <label class="sr" for="home-url-2">Site address</label>
        <input id="home-url-2" name="url" type="text" inputmode="url" placeholder="your-site.com" autocomplete="url" required />
        <button type="submit">Check for free</button>
      </form>
    </section>

  </main>
</CommercialLayout>

<style>
  .hm { max-width: 1000px; margin: 0 auto; padding: 0 20px 40px; }
  .hm section { padding-block: 52px; border-top: 1px solid rgba(255,255,255,.08); }
  .hm section:first-child { border-top: 0; }
  .hm h1, .hm h2, .hm h3 { text-wrap: balance; }
  .hm h2 { font-family: var(--fd); font-weight: 600; font-size: clamp(23px, 3.6vw, 32px); line-height: 1.15; margin: 0 0 8px; }
  .hm .eyebrow { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--teal-soft); margin: 0 0 12px; }
  .hm .lede { color: #C6CBD2; font-size: 17px; max-width: 62ch; margin: 8px 0 0; }
  .hm .muted { color: var(--muted); font-size: 14px; margin-top: 16px; }
  .hm a { color: var(--teal-soft); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }

  .hero { text-align: center; padding-block: 56px 40px; }
  .hero h1 { font-family: var(--fd); font-weight: 600; font-size: clamp(30px, 5.2vw, 50px); line-height: 1.1; letter-spacing: -.015em; margin: 0 0 16px; }
  .hero h1 em { font-style: normal; color: var(--teal-soft); }
  .hero .lede { margin: 0 auto 26px; }
  .check { display: flex; gap: 10px; max-width: 520px; margin: 0 auto; flex-wrap: wrap; }
  .check input { flex: 1 1 240px; min-width: 0; height: 54px; background: #141C28; border: 1px solid #243040; border-radius: 10px; padding: 0 16px; color: var(--paper); font: inherit; font-size: 16px; }
  .check input::placeholder { color: var(--muted); }
  .check input:focus { outline: 2px solid var(--teal-soft); outline-offset: 1px; }
  .check button { height: 54px; padding: 0 26px; background: var(--teal-soft); color: #06231F; border: 0; border-radius: 10px; font: inherit; font-size: 16px; font-weight: 600; cursor: pointer; white-space: nowrap; }
  .check button:hover { background: #4fc9ba; }
  .under { margin: 14px 0 0; font-size: 13px; color: var(--muted); }
  .under b { color: var(--paper); font-weight: 500; }

  .sample { background: #141C28; border: 1px solid #243040; border-radius: 16px; padding: 22px; margin-top: 34px; text-align: left; }
  .sample-top { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .num { font-family: var(--fd); font-weight: 600; font-size: 58px; line-height: 1; color: var(--amber-soft); }
  .num span { font-size: 20px; color: var(--muted); }
  .sample-top p { margin: 0; font-size: 14px; color: #C6CBD2; flex: 1 1 260px; min-width: 0; }
  .bars { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin-top: 20px; }
  .bar-label { font-size: 12px; color: var(--muted); margin: 0 0 6px; line-height: 1.35; min-height: 2.7em; }
  .track { height: 7px; background: #0E1520; border-radius: 4px; overflow: hidden; }
  .fill { height: 100%; background: var(--teal); border-radius: 4px; }
  .fill.low { background: #C9922A; }
  .val { font-size: 12px; color: var(--paper); margin: 6px 0 0; font-variant-numeric: tabular-nums; }

  .three { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 24px; }
  .card { background: #141C28; border: 1px solid #243040; border-radius: 14px; padding: 22px; }
  .card h3 { font-size: 17px; font-weight: 600; margin: 0 0 8px; }
  .card p { margin: 0; font-size: 15px; color: #C6CBD2; }
  .tag { display: inline-block; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--teal-soft); margin: 0 0 12px; }

  .steps { list-style: none; counter-reset: s; display: grid; gap: 14px; margin: 22px 0 0; padding: 0; max-width: 760px; }
  .steps li { counter-increment: s; display: flex; gap: 16px; align-items: flex-start; }
  .steps li > div { flex: 1; min-width: 0; }
  .steps li::before { content: counter(s); flex: 0 0 34px; height: 34px; border-radius: 50%; background: #1B2533; color: var(--teal-soft); font-family: var(--fd); font-size: 16px; font-weight: 600; display: flex; align-items: center; justify-content: center; }
  .steps b { display: block; color: var(--paper); font-weight: 500; font-size: 16px; }
  .steps p { margin: 4px 0 0; font-size: 15px; color: #C6CBD2; }

  .honest { background: #141C28; border: 1px solid #243040; border-left: 3px solid var(--amber-soft); border-radius: 0 14px 14px 0; padding: 22px 24px; margin-top: 20px; max-width: 760px; }
  .honest p { margin: 0 0 10px; font-size: 15px; color: #C6CBD2; }
  .honest p:last-child { margin: 0; }
  .honest b { color: var(--paper); font-weight: 500; }
  .honest b.amber { color: var(--amber-soft); font-weight: 600; }

  .mods { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px; margin-top: 22px; }
  .mod { background: #141C28; border: 1px solid #243040; border-radius: 10px; padding: 14px 16px; }
  .mod.core { border-color: var(--teal); }
  .mod b { display: block; font-size: 14px; font-weight: 500; }
  .mod span { display: block; font-size: 12px; color: var(--muted); margin: 2px 0 8px; }
  .mod p { margin: 0; font-size: 13px; color: #B8BFC7; line-height: 1.45; }

  .final { text-align: center; padding-block: 60px; }
  .final h2 { font-size: clamp(24px, 4vw, 36px); }
  .final .lede { margin: 0 auto 24px; }
  @media (max-width: 560px) { .hm section { padding-block: 40px; } .num { font-size: 46px; } }
</style>
