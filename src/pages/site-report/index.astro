      .changelog-date { min-width: 0; margin-bottom: 6px; }
      .footer { padding: 24px 14px; line-height: 1.5; }
    }

    /* ── GROWTH DASHBOARD v19 ── */
    :root {
      --ink: #1c1917;
      --ink-soft: #2c4a44;
      --accent: #3DB8A9;
      --accent-dark: #1A8A7D;
      --paper-2: #faf8f4;
      --card: #ffffff;
      --border: #e7e5e4;
      --muted: #78716c;
      --up: #15803d;
      --down: #dc2626;
      --shadow: 0 4px 24px rgba(26, 46, 42, 0.06);
      --radius: 14px;
    }

    .kpi-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
      margin-top: 8px;
      margin-bottom: 32px;
    }
    @media (max-width: 1100px) { .kpi-strip { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .kpi-strip { grid-template-columns: 1fr; } }
    .kpi-card {
      background: var(--card);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      padding: 18px 16px;
      box-shadow: var(--shadow);
    }
    .kpi-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
