{
  "name": "oper-stack-website",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "healthcheck": "node scripts/post-deploy-smoke.mjs --http-only",
    "audit:drafts": "node scripts/audit-guide-drafts.mjs",
    "aeo:verify": "node scripts/reference-infra/verify-reference-infra.mjs --config reference-infra.config.json --robots public/robots.txt",
    "aeo:dates": "node scripts/reference-infra/restore-real-updated-dates.mjs --config reference-infra.config.json",
    "aeo:markdown": "node scripts/reference-infra/fix-markdown-structure.mjs --config reference-infra.config.json",
    "aeo:robots": "node scripts/reference-infra/generate-robots.mjs --config reference-infra.config.json --output public/robots.txt",
    "aeo:llms": "node scripts/reference-infra/generate-agent-markdown.mjs --config reference-infra.config.json --output-dir public",
    "audit:design": "node more-group-content-os/scripts/audit-design.mjs --fail",
    "audit:design:report": "node more-group-content-os/scripts/audit-design.mjs",
    "postbuild": "node scripts/patch-vercel-output.mjs",
    "prebuild": "node scripts/ai-visibility/page-lastmod.mjs && node scripts/ai-visibility/generate-agent-markdown.mjs && node scripts/ai-visibility/generate-agent-card.mjs && node scripts/ai-visibility/check-agent-index.mjs && node scripts/check-product-counts.mjs && node scripts/build-visit-script.mjs --check && node scripts/measure-own-score.mjs",
    "ai:markdown": "node scripts/ai-visibility/generate-agent-markdown.mjs",
    "ai:card": "node scripts/ai-visibility/generate-agent-card.mjs",
    "ai:lastmod": "node scripts/ai-visibility/page-lastmod.mjs",
    "ai:check": "node scripts/ai-visibility/check-agent-index.mjs",
    "ai:verify": "node scripts/ai-visibility/verify-live.mjs",
    "smoke": "node scripts/smoke-live.mjs",
    "test:lang": "node scripts/test-ai-visibility-lang.mjs",
    "test:commerce": "node scripts/test-commerce.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.1",
    "@astrojs/vercel": "10.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@operstack/audit": "^0.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "6.0.8",
    "google-auth-library": "^10.9.1",
    "nodemailer": "^10.0.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^26.6.2",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
