    "allowSearchCrawlers": true,
    "allowTrainingCrawlers": true
  },
  "markdownStructure": {
    "prefixes": []
  },
  "llms": {
    "enabled": false,
    "path": "/llms.txt",
    "title": "OperStack reference content",
    "description": "Optional machine-readable index of selected public guides."
  }
}
